```bash
python3 - <<'PY'
from pathlib import Path

p = Path("README")
s = p.read_text()
section = Path("/tmp/test_falcon_readme_section.md").read_text()

if "## Reproducible `test_falcon` result" in s:
    print("test_falcon section already present")
else:
    marker = "## Acknowledgements"
    if marker in s:
        idx = s.find(marker)
        next_idx = s.find("\n## ", idx + 1)
        if next_idx != -1:
            s = s[:next_idx] + section + s[next_idx:]
        else:
            s = s + section
    else:
        lines = s.splitlines(True)
        out = []
        inserted = False
        for line in lines:
            out.append(line)
            if not inserted and line.startswith("# "):
                out.append(section)
                inserted = True
        if not inserted:
            out = [section + "\n"] + lines
        s = "".join(out)

    p.write_text(s)
    print("Inserted test_falcon result section")
PY

