FLOOR_ZERO : ∀ (x : Word), NumericCenter x → floorC x = floorVal x - eps0 x
C_INT_BRIDGE : ∀ (x : Word),
  NumericCenter x →
    ∀ (z : Int),
      -365 ≤ z ∧ z ≤ 366 →
        -2147483648 ≤ floorC x ∧ floorC x ≤ 2147483647 ∧ -2147483648 ≤ floorC x + z ∧ floorC x + z ≤ 2147483647
