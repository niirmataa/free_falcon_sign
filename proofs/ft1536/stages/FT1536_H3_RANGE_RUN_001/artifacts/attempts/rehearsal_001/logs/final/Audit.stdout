H3Range.floor_refinement : ∀ (s : Bool) (e f : Nat),
  LE.le.{0} e 1053 →
    LT.lt.{0} f 4503599627370496 →
      H3Range.NotNegZero s e f → Eq.{1} (H3Range.floorParts s e f) (H3Range.mathFloor s e f)
H3Range.negative_zero_exception : Eq.{1} (H3Range.floorParts true 0 0) (-1) ∧ Eq.{1} (H3Range.mathFloor true 0 0) 0
H3Range.negative_zero_sum_still_safe : ∀ (z : Int),
  LE.le.{0} (-365) z ∧ LE.le.{0} z 366 →
    LE.le.{0} (-2147483648) (HAdd.hAdd.{0, 0, 0} (H3Range.floorParts true 0 0) z) ∧
      LE.le.{0} (HAdd.hAdd.{0, 0, 0} (H3Range.floorParts true 0 0) z) 2147483647
H3Range.lt128_correct : ∀ (xh xl yh yl : Nat),
  LT.lt.{0} xh 18446744073709551616 →
    LT.lt.{0} xl 18446744073709551616 →
      LT.lt.{0} yh 18446744073709551616 →
        LT.lt.{0} yl 18446744073709551616 →
          Eq.{1} (H3Range.lt128 xh xl yh yl)
            (ite.{1}
              (LT.lt.{0} (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} xh 18446744073709551616) xl)
                (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} yh 18446744073709551616) yl))
              1 0)
H3Range.all_bank_support : ∀ (i : Fin 5) (r : Nat), LE.le.{0} (H3Range.above r (H3Range.bank i)) 365
H3Range.proposal_return_safe : ∀ (s : Int),
  LE.le.{0} (-2147483283) s ∧ LE.le.{0} s 2147483281 →
    ∀ (k : Nat),
      LE.le.{0} k 365 →
        ∀ (b : Bool),
          LE.le.{0} (-2147483648) (HAdd.hAdd.{0, 0, 0} s (H3Range.proposalZ k b)) ∧
            LE.le.{0} (HAdd.hAdd.{0, 0, 0} s (H3Range.proposalZ k b)) 2147483647
H3Range.terminal_right_then_left : ∀ (D r1 rx r0 pre0 fl0 z0 err2 err3 E1 Eh E2 E3 : Int),
  LT.lt.{0} 0 D →
    H3Range.Between r1 (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 366 D) E1) →
      H3Range.Between (HSub.hSub.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 rx) r1) (HMul.hMul.{0, 0, 0} 2 Eh) →
        LE.le.{0} 0 (HSub.hSub.{0, 0, 0} pre0 (HMul.hMul.{0, 0, 0} D fl0)) ∧
            LT.lt.{0} (HSub.hSub.{0, 0, 0} pre0 (HMul.hMul.{0, 0, 0} D fl0)) D →
          LE.le.{0} (-365) z0 ∧ LE.le.{0} z0 366 →
            H3Range.Between err2 E2 →
              H3Range.Between err3 E3 →
                Eq.{1} r0
                    (HAdd.hAdd.{0, 0, 0}
                      (HSub.hSub.{0, 0, 0}
                        (HAdd.hAdd.{0, 0, 0}
                          (HSub.hSub.{0, 0, 0} pre0 (HMul.hMul.{0, 0, 0} D (HAdd.hAdd.{0, 0, 0} fl0 z0))) err2)
                        rx)
                      err3) →
                  H3Range.Between (HMul.hMul.{0, 0, 0} 2 r0)
                    (HAdd.hAdd.{0, 0, 0}
                      (HAdd.hAdd.{0, 0, 0}
                        (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 1098 D) E1)
                          (HMul.hMul.{0, 0, 0} 2 Eh))
                        (HMul.hMul.{0, 0, 0} 2 E2))
                      (HMul.hMul.{0, 0, 0} 2 E3))
H3Range.next_terminal_center : ∀ (t0 r1 rx c err T R Eh Ea : Int),
  H3Range.Between t0 T →
    H3Range.Between r1 R →
      H3Range.Between (HSub.hSub.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 rx) r1) (HMul.hMul.{0, 0, 0} 2 Eh) →
        H3Range.Between err Ea →
          Eq.{1} c (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} t0 rx) err) →
            H3Range.Between (HMul.hMul.{0, 0, 0} 2 c)
              (HAdd.hAdd.{0, 0, 0}
                (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 T) R) (HMul.hMul.{0, 0, 0} 2 Eh))
                (HMul.hMul.{0, 0, 0} 2 Ea))
H3Range.checked_key_coefficients : ∀ (xs ys : List.{0} Int),
  Eq.{1} (H3Range.smallLoop xs) (some.{0} ys) →
    Eq.{1} ys xs ∧ ∀ (x : Int), Membership.mem.{0, 0} ys x → LE.le.{0} (-2047) x ∧ LE.le.{0} x 2047
H3Range.guards_do_not_imply_floor_refinement : Exists.{1} fun mu =>
  Exists.{1} fun sigma =>
    Eq.{1} (H3Range.admitCall 0 mu sigma) (H3Range.Admission.atFloor mu sigma) ∧
      Ne.{1} (H3Range.floorParts (H3Range.signBit mu) (H3Range.exponent mu) (H3Range.fraction mu))
        (H3Range.mathFloor (H3Range.signBit mu) (H3Range.exponent mu) (H3Range.fraction mu))
H3Range.complete_local_lift : ∀ (mu : Nat),
  H3Range.CenterClass mu →
    ∀ (k : Nat),
      LE.le.{0} k 365 →
        ∀ (b : Bool),
          Eq.{1} (H3Range.floorParts (H3Range.signBit mu) (H3Range.exponent mu) (H3Range.fraction mu))
              (H3Range.mathFloor (H3Range.signBit mu) (H3Range.exponent mu) (H3Range.fraction mu)) ∧
            LE.le.{0} (-2147483648)
                (HAdd.hAdd.{0, 0, 0}
                  (H3Range.floorParts (H3Range.signBit mu) (H3Range.exponent mu) (H3Range.fraction mu))
                  (H3Range.proposalZ k b)) ∧
              LE.le.{0}
                (HAdd.hAdd.{0, 0, 0}
                  (H3Range.floorParts (H3Range.signBit mu) (H3Range.exponent mu) (H3Range.fraction mu))
                  (H3Range.proposalZ k b))
                2147483647
