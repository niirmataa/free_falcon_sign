fun (f : Bool) (os : List.{0} OrderedReach.Outcome) (h : @Eq.{1} Bool (OrderedReach.faults f os) Bool.false) =>
  @List.rec.{0, 0} OrderedReach.Outcome
    (fun (os : List.{0} OrderedReach.Outcome) =>
