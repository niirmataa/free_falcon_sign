  @Eq.{1} Bool (OrderedReach.faults Bool.true os) Bool.true
theorem OrderedReach.fault_sticky : ∀ (os : List.{0} OrderedReach.Outcome),
  @Eq.{1} Bool (OrderedReach.faults Bool.true os) Bool.true :=
fun (os : List.{0} OrderedReach.Outcome) =>
  @List.rec.{0, 0} OrderedReach.Outcome
    (fun (os : List.{0} OrderedReach.Outcome) => @Eq.{1} Bool (OrderedReach.faults Bool.true os) Bool.true)
    (@Eq.refl.{1} Bool (OrderedReach.faults Bool.true (@List.nil.{0} OrderedReach.Outcome)))
    (fun (o : OrderedReach.Outcome) (os : List.{0} OrderedReach.Outcome)
        (ih : @Eq.{1} Bool (OrderedReach.faults Bool.true os) Bool.true) =>
      @OrderedReach.Outcome.casesOn.{0}
        (fun (t : OrderedReach.Outcome) =>
          ∀ (h : @Eq.{1} OrderedReach.Outcome o t),
            @Eq.{1} Bool (OrderedReach.faults Bool.true (@List.cons.{0} OrderedReach.Outcome o os)) Bool.true)
        o
        (fun (sample : Int) (h : @Eq.{1} OrderedReach.Outcome o (OrderedReach.Outcome.normal sample)) =>
          @Eq.ndrec.{0, 1} OrderedReach.Outcome (OrderedReach.Outcome.normal sample)
            (fun (o : OrderedReach.Outcome) =>
              @Eq.{1} Bool (OrderedReach.faults Bool.true (@List.cons.{0} OrderedReach.Outcome o os)) Bool.true)
            (@of_eq_true
              (@Eq.{1} Bool
                (OrderedReach.faults Bool.true
                  (@List.cons.{0} OrderedReach.Outcome (OrderedReach.Outcome.normal sample) os))
                Bool.true)
              (@Eq.trans.{1} Prop
                (@Eq.{1} Bool
                  (OrderedReach.faults Bool.true
                    (@List.cons.{0} OrderedReach.Outcome (OrderedReach.Outcome.normal sample) os))
                  Bool.true)
                (@Eq.{1} Bool Bool.true Bool.true) True
                (@congrFun'.{1, 1} Bool Prop
                  (@Eq.{1} Bool
                    (OrderedReach.faults Bool.true
                      (@List.cons.{0} OrderedReach.Outcome (OrderedReach.Outcome.normal sample) os)))
                  (@Eq.{1} Bool Bool.true)
                  (@congrArg.{1, 1} Bool (Bool → Prop)
                    (OrderedReach.faults Bool.true
                      (@List.cons.{0} OrderedReach.Outcome (OrderedReach.Outcome.normal sample) os))
                    Bool.true (@Eq.{1} Bool) ih)
                  Bool.true)
                (@eq_self.{1} Bool Bool.true)))
            o (@Eq.symm.{1} OrderedReach.Outcome o (OrderedReach.Outcome.normal sample) h))
        (fun (h : @Eq.{1} OrderedReach.Outcome o OrderedReach.Outcome.fault) =>
          @Eq.ndrec.{0, 1} OrderedReach.Outcome OrderedReach.Outcome.fault
            (fun (o : OrderedReach.Outcome) =>
              @Eq.{1} Bool (OrderedReach.faults Bool.true (@List.cons.{0} OrderedReach.Outcome o os)) Bool.true)
            (@of_eq_true
              (@Eq.{1} Bool
                (OrderedReach.faults Bool.true (@List.cons.{0} OrderedReach.Outcome OrderedReach.Outcome.fault os))
                Bool.true)
              (@Eq.trans.{1} Prop
                (@Eq.{1} Bool
                  (OrderedReach.faults Bool.true (@List.cons.{0} OrderedReach.Outcome OrderedReach.Outcome.fault os))
                  Bool.true)
                (@Eq.{1} Bool Bool.true Bool.true) True
                (@congrFun'.{1, 1} Bool Prop
                  (@Eq.{1} Bool
                    (OrderedReach.faults Bool.true (@List.cons.{0} OrderedReach.Outcome OrderedReach.Outcome.fault os)))
                  (@Eq.{1} Bool Bool.true)
                  (@congrArg.{1, 1} Bool (Bool → Prop)
                    (OrderedReach.faults Bool.true (@List.cons.{0} OrderedReach.Outcome OrderedReach.Outcome.fault os))
                    Bool.true (@Eq.{1} Bool) ih)
                  Bool.true)
                (@eq_self.{1} Bool Bool.true)))
            o (@Eq.symm.{1} OrderedReach.Outcome o OrderedReach.Outcome.fault h))
        (fun (h : @Eq.{1} OrderedReach.Outcome o OrderedReach.Outcome.stutter) =>
          @Eq.ndrec.{0, 1} OrderedReach.Outcome OrderedReach.Outcome.stutter
            (fun (o : OrderedReach.Outcome) =>
              @Eq.{1} Bool (OrderedReach.faults Bool.true (@List.cons.{0} OrderedReach.Outcome o os)) Bool.true)
            (@of_eq_true
              (@Eq.{1} Bool
