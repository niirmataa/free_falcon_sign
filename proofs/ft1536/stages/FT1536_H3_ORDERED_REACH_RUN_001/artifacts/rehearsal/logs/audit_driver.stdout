            @Membership.mem.{0, 0} OrderedReach.Outcome (List.{0} OrderedReach.Outcome)
                (@List.instMembership.{0} OrderedReach.Outcome) os o →
              @Ne.{1} OrderedReach.Outcome o OrderedReach.Outcome.fault))
    (fun (f : Bool) (h : @Eq.{1} Bool (OrderedReach.faults f (@List.nil.{0} OrderedReach.Outcome)) Bool.false) =>
      @And.intro (@Eq.{1} Bool f Bool.false)
