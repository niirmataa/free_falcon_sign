--- ber_original.inc
+++ ber_observer.inc
@@ -1,5 +1,5 @@
 static int
-BerExp(prng *p, fpr x)
+observed_BerExp(prng *p, fpr x)
 {
 	int s;
 	fpr r;
@@ -28,7 +28,7 @@
 	 *  - keep only s bits
 	 *  - bit is 1 if the result is zero
 	 */
-	w = falcon_prng_get_u64(p);
+	w = observed_u64(p);
 	w ^= (w >> safe_s) << safe_s;
 	b = 1 - (int)((w | -w) >> 63);
 	b &= 1 ^ (int)over;
@@ -38,9 +38,10 @@
 	 * returns exp(-r)*2^63 and is reduced to the 55-bit comparison domain.
 	 */
 	z = fpr_expm_scaled(r) >> 8;
-	w = falcon_prng_get_u64(p);
+	w = observed_u64(p);
 	w &= ((uint64_t)1 << 55) - 1;
 	b &= (int)((w - z) >> 63);
 
+	printf("BE %016" PRIx64 " %d %016" PRIx64 " %016" PRIx64 " %016" PRIx64 " %u %u %d\n", x,s,r,fpr_expm_scaled(r),z,safe_s,over,b);
 	return b;
 }
