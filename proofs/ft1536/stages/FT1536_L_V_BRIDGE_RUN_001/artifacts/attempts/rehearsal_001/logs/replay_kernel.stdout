source_pair_prefix : ∀ (h : Nat),
  HalfOK h →
    ∀ (op : Nat → (Bool → Int) → Bool → Int) (n : Nat),
      n ≤ 768 →
        ∀ (s : Mem) (b : Nat),
          b < 768 →
            ∀ (k : Bool),
              runSteps (pairStep (pairAddr h) op) n s (pairAddr h b k) =
                if b < n then op b (fun l => s (pairAddr h b l)) k else s (pairAddr h b k)
source_triple_prefix : ∀ (op : Nat → (Fin 3 → Int) → Fin 3 → Int) (n : Nat),
  n ≤ 512 →
    ∀ (s : Mem) (b : Nat),
      b < 512 →
        ∀ (k : Fin 3),
          runSteps (tripleStep tripleAddr op) n s (tripleAddr b k) =
            if b < n then op b (fun l => s (tripleAddr b l)) k else s (tripleAddr b k)
pair_prefix_canonical : ∀ (h : Nat),
  HalfOK h →
    ∀ (op : Nat → (Bool → Int) → Bool → Int),
      (∀ (b : Nat),
          b < 768 →
            ∀ (v : Bool → Int), (∀ (k : Bool), 0 ≤ v k ∧ v k < 18433) → ∀ (k : Bool), 0 ≤ op b v k ∧ op b v k < 18433) →
        ∀ (n : Nat), n ≤ 768 → ∀ (s : Mem), CanonMem s → CanonMem (runSteps (pairStep (pairAddr h) op) n s)
triple_prefix_canonical : ∀ (op : Nat → (Fin 3 → Int) → Fin 3 → Int),
  (∀ (b : Nat),
      b < 512 →
        ∀ (v : Fin 3 → Int), (∀ (k : Fin 3), 0 ≤ v k ∧ v k < 18433) → ∀ (k : Fin 3), 0 ≤ op b v k ∧ op b v k < 18433) →
    ∀ (n : Nat), n ≤ 512 → ∀ (s : Mem), CanonMem s → CanonMem (runSteps (tripleStep tripleAddr op) n s)
