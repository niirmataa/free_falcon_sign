signature_initializes : ∀ (b : Bytes) (xs : List Int),
  signature b = some xs → ∀ (initial : Mem) (i : Fin 1536), writeDecoded 0 xs initial ↑i = listVec xs i
L_V_SOURCE : ∀ (h c : Vec),
  CanonVec h →
    CanonVec c →
      ∀ (b : Bytes),
        LegalBytes b →
          V_CAND h c b = 1 →
            ∃ xs z,
              signature b = some xs ∧
                xs.length = 1536 ∧
                  (∀ (initial : Mem) (i : Fin 1536), writeDecoded 0 xs initial ↑i = listVec xs i) ∧
                    Ext0 h c b = some z ∧
                      SignedVec (listVec xs) ∧ Congruent h c z ∧ Q z.fst z.snd < 2093922385 ∧ APIBounds b
