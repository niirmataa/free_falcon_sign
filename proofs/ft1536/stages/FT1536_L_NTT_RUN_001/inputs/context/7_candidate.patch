+/*
+ * FT1536: canonical residue of every decoded int16_t coefficient.
+ * x + 2*q is in [4098,69633], so the C remainder is nonnegative.
+ */
+static uint16_t
+ft1536_normalize_s2(int16_t x)
+{
+	int32_t t;
+
+	t = (int32_t)x + 36866;
+	return (uint16_t)(t % 18433);
+}
