    (fun (h : Eq.{1} (HDiv.hDiv.{0, 0, 0} n 32) 0) =>
      have he :=
        Decidable.byContradiction fun (a : ¬Eq.{1} (HMod.hMod.{0, 0, 0} n 32) n) =>
          B20.Word.ursh_refines._proof_1_2 n h a;
