    Decidable.byContradiction fun (a : ¬(Eq.{1} (HDiv.hDiv.{0, 0, 0} n 32) 0 ∨ Eq.{1} (HDiv.hDiv.{0, 0, 0} n 32) 1)) =>
      B20.Word.ursh_refines._proof_1_1 n hn a;
