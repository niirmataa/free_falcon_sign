                          (Eq.trans.{1} (congrArg.{1, 1} Neg.neg.{0} (congrArg.{1, 1} (BitVec.ofNat 64) h))
                            (BitVec.neg_zero 64)))
                        BitVec.and_zero))
                    BitVec.xor_zero))
                he))
            (HShiftRight.hShiftRight.{0, 0, 0} x n))
          (eq_self.{1} (HShiftRight.hShiftRight.{0, 0, 0} x n))))
    fun (h : Eq.{1} (HDiv.hDiv.{0, 0, 0} n 32) 1) =>
    have he :=
      Decidable.byContradiction fun (a : ¬Eq.{1} (HAdd.hAdd.{0, 0, 0} 32 (HMod.hMod.{0, 0, 0} n 32)) n) =>
        B20.Word.ursh_refines._proof_1_4 n h a;
    of_eq_true
      (Eq.trans.{1}
        (congrFun'.{1, 1}
          (congrArg.{1, 1} Eq.{1}
            (Eq.trans.{1}
              (Eq.trans.{1}
