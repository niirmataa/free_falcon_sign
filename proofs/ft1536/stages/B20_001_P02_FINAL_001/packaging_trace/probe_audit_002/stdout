                                (have this := of_decide_eq_true (id.{0} (Eq.refl.{1} Bool.true));
                                this)))
                            BitVec.and_allOnes))
                        (B20.Word.ursh_refines._simp_1_5 x x (HShiftRight.hShiftRight.{0, 0, 0} x 32)))
                      (Eq.trans.{1}
                        (congrFun'.{1, 1} (congrArg.{1, 1} HXor.hXor.{0, 0, 0} BitVec.xor_self)
                          (HShiftRight.hShiftRight.{0, 0, 0} x 32))
                        BitVec.zero_xor)))
                  (HMod.hMod.{0, 0, 0} n 32))
                (B20.Word.ursh_refines._simp_1_6 x 32 (HMod.hMod.{0, 0, 0} n 32)))
              (congrArg.{1, 1} (HShiftRight.hShiftRight.{0, 0, 0} x) he)))
