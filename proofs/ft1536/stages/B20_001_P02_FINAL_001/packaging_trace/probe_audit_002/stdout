            (congrArg.{1, 1} Eq.{1}
              (congr.{1, 1}
                (congrArg.{1, 1} HShiftRight.hShiftRight.{0, 0, 0}
                  (Eq.trans.{1}
                    (congrArg.{1, 1} (HXor.hXor.{0, 0, 0} x)
