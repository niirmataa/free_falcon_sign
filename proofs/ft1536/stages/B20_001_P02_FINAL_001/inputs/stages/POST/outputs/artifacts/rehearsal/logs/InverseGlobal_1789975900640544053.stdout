middle_reverse_inverse : ∀ (ps : List (Nat × Nat)),
  (∀ (p : Nat × Nat), p ∈ ps → ParamOK p) →
    ∀ (s : Mem), CanonMem s → inverseMiddle ps.reverse (forwardMiddle ps s) = scaleMem (2 ^ ps.length) s
inverseMem_forwardMem : ∀ (s : Mem), CanonMem s → inverseMem (forwardMem s) = s
inverseC_forwardC : ∀ (v : Vec), CanonVec v → inverseC (forwardC v) = v
inverse_forward : ∀ (v : Vec), liftInverse (liftForward v) = FT1536Composition.canonical v
