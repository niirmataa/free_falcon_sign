'FT1536Bridge.static_head_shifts' depends on axioms: [propext, Classical.choice, Quot.sound]
'FT1536Bridge.static_loop_spec' depends on axioms: [propext, Classical.choice, Quot.sound]
'FT1536Bridge.DECODE_STATIC' depends on axioms: [propext, Classical.choice, Quot.sound]
'FT1536Bridge.listVec_property' depends on axioms: [propext, Quot.sound]
'FT1536Bridge.static_vector_signed' depends on axioms: [propext, Classical.choice, Quot.sound]
