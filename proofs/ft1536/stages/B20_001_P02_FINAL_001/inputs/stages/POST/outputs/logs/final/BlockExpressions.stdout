blockCheck_sound : ∀ (f g : Fin 3 → LExpr) (scale : Int),
  blockCheck f g scale = true →
    ∀ (v : Fin 3 → Int),
      (∀ (j : Fin 3), CanonVal (v j)) → ∀ (k : Fin 3), ((g k).eval fun j => (f j).eval v) = scale * v k % 18433
