root_coefficients : ∀ (s : Mem) (i : Nat),
  i < 768 →
    pairStage 768 forwardRootOp s i = (s i + 14649 * s (i + 768)) % 18433 ∧
      pairStage 768 forwardRootOp s (i + 768) = (s i + (1 - 14649) * s (i + 768)) % 18433
binary_coefficients : ∀ (h m : Nat),
  HalfOK h →
    ∀ (s : Mem) (b : Nat),
      b < 768 →
        pairStage h (forwardBinaryOp m h) s (pairAddr h b false) =
            (s (pairAddr h b false) + s (pairAddr h b true) * ordinary (gmAt (m + b / h))) % 18433 ∧
          pairStage h (forwardBinaryOp m h) s (pairAddr h b true) =
            (s (pairAddr h b false) - s (pairAddr h b true) * ordinary (gmAt (m + b / h))) % 18433
'FT1536Global.mmQ_ordinary' depends on axioms: [propext]
'FT1536Global.ordinary_root' depends on axioms: [propext]
'FT1536Global.root_coefficients' depends on axioms: [propext, Classical.choice, Quot.sound]
'FT1536Global.binary_coefficients' depends on axioms: [propext, Classical.choice, Quot.sound]
'FT1536Global.initialized_binary_read' depends on axioms: [propext, Quot.sound]
'FT1536Global.initialized_cubic_read' depends on axioms: [propext, Quot.sound]
