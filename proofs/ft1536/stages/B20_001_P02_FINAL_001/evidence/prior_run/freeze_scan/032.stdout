B20.C.safe_add32 : ∀ (a b : BitVec 32),
  -2 ^ 31 ≤ a.toInt + b.toInt ∧ a.toInt + b.toInt < 2 ^ 31 →
    B20.C.signedBitsOp B20.C.BinOp.add a b = B20.C.bitsOp B20.C.BinOp.add a b ∧ (a + b).toInt = a.toInt + b.toInt
B20.C.safe_add64 : ∀ (a b : BitVec 64),
  -2 ^ 63 ≤ a.toInt + b.toInt ∧ a.toInt + b.toInt < 2 ^ 63 →
    B20.C.signedBitsOp B20.C.BinOp.add a b = B20.C.bitsOp B20.C.BinOp.add a b ∧ (a + b).toInt = a.toInt + b.toInt
B20.C.safe_sub32 : ∀ (a b : BitVec 32),
  -2 ^ 31 ≤ a.toInt - b.toInt ∧ a.toInt - b.toInt < 2 ^ 31 →
    B20.C.signedBitsOp B20.C.BinOp.sub a b = B20.C.bitsOp B20.C.BinOp.sub a b ∧ (a - b).toInt = a.toInt - b.toInt
B20.C.safe_sub64 : ∀ (a b : BitVec 64),
  -2 ^ 63 ≤ a.toInt - b.toInt ∧ a.toInt - b.toInt < 2 ^ 63 →
    B20.C.signedBitsOp B20.C.BinOp.sub a b = B20.C.bitsOp B20.C.BinOp.sub a b ∧ (a - b).toInt = a.toInt - b.toInt
