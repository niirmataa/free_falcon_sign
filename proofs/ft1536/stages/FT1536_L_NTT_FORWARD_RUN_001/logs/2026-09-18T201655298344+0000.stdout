pair_stage_inverse : ∀ (h : Nat),
  HalfOK h →
    ∀ (f g : PairOp) (c : Int),
      (∀ (b : Nat),
          b < 768 →
            ∀ (v : Bool → Int), (∀ (k : Bool), CanonVal (v k)) → ∀ (k : Bool), g b (f b v) k = c * v k % 18433) →
        ∀ (s : Mem), CanonMem s → pairStage h g (pairStage h f s) = scaleMem c s
triple_stage_inverse : ∀ (f g : TripleOp) (c : Int),
  (∀ (b : Nat),
      b < 512 → ∀ (v : Fin 3 → Int), (∀ (k : Fin 3), CanonVal (v k)) → ∀ (k : Fin 3), g b (f b v) k = c * v k % 18433) →
    ∀ (s : Mem), CanonMem s → tripleStage g (tripleStage f s) = scaleMem c s
pair_stage_homogeneous : ∀ (h : Nat),
  HalfOK h →
    ∀ (g : PairOp) (c : Int),
      (∀ (b : Nat),
          b < 768 →
            ∀ (v : Bool → Int),
              (∀ (k : Bool), CanonVal (v k)) → ∀ (k : Bool), g b (fun j => c * v j % 18433) k = c * g b v k % 18433) →
        ∀ (s : Mem), CanonMem s → pairStage h g (scaleMem c s) = scaleMem c (pairStage h g s)
