sum_congr_mod : ∀ (n : Nat) (f g : Nat → Int),
  (∀ (i : Nat), i < n → f i % 18433 = g i % 18433) → sumN n f % 18433 = sumN n g % 18433
sum_swap : ∀ (n m : Nat) (f : Nat → Nat → Int), (sumN n fun i => sumN m (f i)) = sumN m fun j => sumN n fun i => f i j
sum_ofFn_congr : ∀ (n : Nat) (f : Fin n → Int) (g : Nat → Int),
  (∀ (i : Fin n), f i = g ↑i) → List.foldl (fun x1 x2 => x1 + x2) 0 (List.ofFn f) = sumN n g
