FT1536Forward.FORWARD_GLOBAL : ∀ (v : FT1536Global.Vec),
  FT1536Global.CanonVec v →
    ∀ (b : Fin 512) (j : Fin 3),
      Eq.{1} (FT1536Global.forwardC v ⟨HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 3 ↑b) ↑j, ⋯⟩)
        (HMod.hMod.{0, 0, 0}
          (FT1536Forward.sumN 1536 fun k =>
            HMul.hMul.{0, 0, 0} (FT1536Global.fromVec v k)
              (HPow.hPow.{0, 0, 0}
                (HMul.hMul.{0, 0, 0} (FT1536Global.ordinary (FT1536Global.gmAt (HAdd.hAdd.{0, 0, 0} 512 ↑b)))
                  (HPow.hPow.{0, 0, 0} 14648 ↑j))
                k))
          18433)
