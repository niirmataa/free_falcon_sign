 uint32_t d;

 z = (uint64_t)a * (uint64_t)b;
 w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
 d = (uint32_t)((z + w) >> 31) - p;
 d += p & -(d >> 31);
 return d;
}




static uint32_t
modp_R2(uint32_t p, uint32_t p0i)
{
 uint32_t z;





 z = modp_R(p);
 z = modp_add(z, z, p);





 z = modp_montymul(z, z, p, p0i);
 z = modp_montymul(z, z, p, p0i);
 z = modp_montymul(z, z, p, p0i);
 z = modp_montymul(z, z, p, p0i);
 z = modp_montymul(z, z, p, p0i);




 z = (z + (p & -(z & 1))) >> 1;
 return z;
}






static inline uint32_t
modp_Rx(unsigned x, uint32_t p, uint32_t p0i, uint32_t R2)
{
