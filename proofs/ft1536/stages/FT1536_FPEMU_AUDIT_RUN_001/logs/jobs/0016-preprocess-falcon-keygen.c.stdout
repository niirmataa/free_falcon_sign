 poly_big_to_fp(rt3, ft, slen, slen, logn, 0, maxbl_fg, 0);
 poly_big_to_fp(rt4, gt, slen, slen, logn, 0, maxbl_fg, 0);




 memmove(fk->tmp, rt1, 4 * n * sizeof *rt1);
 rt1 = (fpr *)fk->tmp;
