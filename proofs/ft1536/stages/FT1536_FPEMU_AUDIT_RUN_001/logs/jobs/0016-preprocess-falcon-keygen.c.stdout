static void
make_fg_ternary_top(uint32_t *data, unsigned logn, int out_ntt)
{
# 5631 "inputs/bootstrap/source/falcon-keygen.c"
 size_t n, dn, tn, u, v;
 uint32_t *gm, *igm, *fd, *gd, *fs, *gs;
 uint32_t p, p0i, R2, R3;

 n = ((size_t)(1 + ((1) << 1)) << ((logn) - (1)));
 dn = ((size_t)(1 + ((0) << 1)) << ((logn) - (0)));
 tn = ((size_t)(1 + ((0) << 1)) << ((logn - 1) - (0)));
