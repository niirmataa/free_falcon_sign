static inline fpr
fpr_log_emu(fpr x)
{
 fpr m, y, y2, acc;
 int e, i;

 e = (int)((x >> 52) & 0x7FF) - 1023;
 m = (x & (((uint64_t)1 << 52) - 1)) | ((uint64_t)1023 << 52);
 y = fpr_div(fpr_sub(m, fpr_one), fpr_add(m, fpr_one));
