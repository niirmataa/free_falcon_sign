static inline uint64_t
fpr_mul_high_u64(uint64_t x, uint64_t y)
{
 uint32_t x0, x1, y0, y1;
 uint64_t a, b, c;

 x0 = (uint32_t)x;
 x1 = (uint32_t)(x >> 32);
 y0 = (uint32_t)y;
 y1 = (uint32_t)(y >> 32);
