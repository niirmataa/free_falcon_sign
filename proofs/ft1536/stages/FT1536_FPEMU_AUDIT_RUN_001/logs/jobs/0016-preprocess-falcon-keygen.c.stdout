  Gp[u] = modp_set(zint_one_to_plain(Gp + u), p);
 }
 modp_NTT2_ext(Fp, 1, gm, logn - 1, p, p0i);
 modp_NTT2_ext(Gp, 1, gm, logn - 1, p, p0i);




 for (u = 0; u < n; u ++) {
