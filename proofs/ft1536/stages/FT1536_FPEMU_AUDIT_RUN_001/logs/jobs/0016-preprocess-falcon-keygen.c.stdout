 falcon_iFFT(rt2, logn);




 Ft = fk->tmp;
 Gt = Ft + n;
 rt3 = align_fpr(fk->tmp, Gt + n);
 memmove(rt3, rt1, 2 * n * sizeof *rt1);
 rt1 = rt3;
 rt2 = rt1 + n;
 for (u = 0; u < n; u ++) {
