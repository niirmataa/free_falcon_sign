 p = PRIMES3[0].p;
 p0i = modp_ninv31(p);
 R2 = modp_R2(p, p0i);

 modp_mkgm3(gm, igm, logn, 1, PRIMES3[0].g, p, p0i);
 modp_NTT3_ext(fs, 1, gm, logn, 1, p, p0i);
 modp_NTT3_ext(gs, 1, gm, logn, 1, p, p0i);

 R3 = modp_montymul(R2, R2, p, p0i);

