  + (((uint64_t)x0 * (uint64_t)y0) >> 32);
 b = (uint64_t)x1 * (uint64_t)y0;
 c = (a >> 32) + (b >> 32);
 c += ((uint64_t)(uint32_t)a + (uint64_t)(uint32_t)b) >> 32;
 c += (uint64_t)x1 * (uint64_t)y1;
 return c;
}

