 uint32_t r, z;






 x --;
 r = R2;
 z = modp_R(p);
 for (i = 0; (1U << i) <= x; i ++) {
  if ((x & (1U << i)) != 0) {
   z = modp_montymul(z, r, p, p0i);
  }
  r = modp_montymul(r, r, p, p0i);
 }
 return z;
}
