 }




 rt1 = align_fpr(fk->tmp, gt + slen * n);
 rt2 = rt1 + n;
 poly_big_to_fp(rt1, Ft, llen, llen, logn, 0, maxbl_FG, 0);
 poly_big_to_fp(rt2, Gt, llen, llen, logn, 0, maxbl_FG, 0);





