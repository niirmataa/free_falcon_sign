 R2 = modp_R2(p, p0i);

 Fp = fk->tmp;
 Gp = Fp + hn;
 ft = Gp + hn;
 gt = ft + n;
 gm = gt + n;
 igm = gm + n;

 modp_mkgm2(gm, igm, logn, PRIMES2[0].g, p, p0i);




 for (u = 0; u < hn; u ++) {
