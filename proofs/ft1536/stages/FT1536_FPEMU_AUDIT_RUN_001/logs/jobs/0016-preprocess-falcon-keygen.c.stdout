 maxbl_G = poly_max_bitlength(Gt, llen, llen, logn, 0);
 maxbl_FG = maxbl_F < maxbl_G ? maxbl_G : maxbl_F;

 if (maxbl_fg > 53 || maxbl_FG > 53) {
