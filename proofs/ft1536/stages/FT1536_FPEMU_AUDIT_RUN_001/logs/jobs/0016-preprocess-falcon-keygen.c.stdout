# 5681 "inputs/bootstrap/source/falcon-keygen.c"
static void
make_fg(uint32_t *data, const int16_t *f, const int16_t *g,
 unsigned logn, unsigned ter, unsigned depth, int out_ntt)
{
 size_t n, u;
 uint32_t *ft, *gt, p0;
 unsigned d;
 const small_prime *primes;

 n = ((size_t)(1 + ((ter) << 1)) << ((logn) - (ter)));
 ft = data;
 gt = ft + n;
 primes = ter ? PRIMES3 : PRIMES2;
 p0 = primes[0].p;
 for (u = 0; u < n; u ++) {
  ft[u] = modp_set(f[u], p0);
  gt[u] = modp_set(g[u], p0);
 }

 if (depth == 0 && out_ntt) {
  uint32_t *gm, *igm;
  uint32_t p, p0i;

  p = primes[0].p;
  p0i = modp_ninv31(p);
  gm = gt + n;
  igm = gm + ((size_t)(1 + ((0) << 1)) << ((logn) - (0)));
  if (ter) {
   modp_mkgm3(gm, igm, logn, 1, primes[0].g, p, p0i);
   modp_NTT3_ext(ft, 1, gm, logn, 1, p, p0i);
   modp_NTT3_ext(gt, 1, gm, logn, 1, p, p0i);
  } else {
   modp_mkgm2(gm, igm, logn, primes[0].g, p, p0i);
   modp_NTT2_ext(ft, 1, gm, logn, p, p0i);
   modp_NTT2_ext(gt, 1, gm, logn, p, p0i);
  }
  return;
 }

 if (ter) {
  make_fg_ternary_top(data, logn, depth > 1 || out_ntt);
  for (d = 1; d < depth; d ++) {
   make_fg_step(data, logn - d, d, 1,
    1, (d + 1) < depth || out_ntt);
  }
 } else {
  for (d = 0; d < depth; d ++) {
   make_fg_step(data, logn - d, d, 0,
    d != 0, (d + 1) < depth || out_ntt);
  }
 }
}
