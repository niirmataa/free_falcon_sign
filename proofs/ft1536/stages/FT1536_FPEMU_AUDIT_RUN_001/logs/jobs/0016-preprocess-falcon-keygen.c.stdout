 modp_NTT2_ext(Fp, 1, t1, logn, p, p0i);
 modp_NTT2_ext(Gp, 1, t1, logn, p, p0i);





 t4[0] = t5[0] = modp_set(f[0], p);
 for (u = 1; u < n; u ++) {
  t4[u] = modp_set(f[u], p);
  t5[n - u] = modp_set(-f[u], p);
 }
 modp_NTT2_ext(t4, 1, t1, logn, p, p0i);
 modp_NTT2_ext(t5, 1, t1, logn, p, p0i);




 for (u = 0; u < n; u ++) {
