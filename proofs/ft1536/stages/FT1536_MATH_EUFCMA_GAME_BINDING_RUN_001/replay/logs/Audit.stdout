@FT1536.GameMach.step_eq : ∀ {C : Type} (targets : ℕ → C) (verdict : FT1536.GameMach.Verdict C)
  (m : FT1536.GameMach.Mach C) (op : FT1536.GameMach.Op) (env : FT1536.GameMach.Env C),
  Eq.{1} m.stopped false ∧ Eq.{1} m.over false →
    Eq.{1} (FT1536.GameMach.step targets verdict m op env)
      (match op with
      | FT1536.GameMach.Op.hq k =>
        Prod.mk.{0, 0}
          { st := (FT1536.ROM.hash targets (FT1536.GameNames.tableAddr (FT1536.GameByte.render k)) m.st).2,
            mode := m.mode, stopped := m.stopped, over := m.over, hq := HAdd.hAdd.{0, 0, 0} m.hq 1, sq := m.sq }
          (FT1536.GameMach.Reply.hval
            (FT1536.ROM.hash targets (FT1536.GameNames.tableAddr (FT1536.GameByte.render k)) m.st).1)
      | FT1536.GameMach.Op.sq msg =>
        have ss := FT1536.GameMach.signStep m.mode (FT1536.ROM.submit msg m.st) env.nonce msg env;
        Prod.mk.{0, 0}
          { st := ss.1, mode := m.mode, stopped := ss.2.2, over := m.over, hq := m.hq,
            sq := HAdd.hAdd.{0, 0, 0} m.sq 1 }
          ss.2.1
      | FT1536.GameMach.Op.fin r msg sg =>
        Prod.mk.{0, 0}
          { st := (FT1536.ROM.hash targets (FT1536.GameNames.tableAddr (FT1536.GameByte.signName r msg)) m.st).2,
            mode := m.mode, stopped := m.stopped, over := true, hq := m.hq, sq := m.sq }
          (FT1536.GameMach.Reply.verdict
            (decide
                (msg ∉
                  (FT1536.ROM.hash targets (FT1536.GameNames.tableAddr (FT1536.GameByte.signName r msg))
                        m.st).2.seen) &&
              verdict (FT1536.ROM.hash targets (FT1536.GameNames.tableAddr (FT1536.GameByte.signName r msg)) m.st).1 msg
                (FT1536.GameMach.sigVec sg))
            (FT1536.ROM.hash targets (FT1536.GameNames.tableAddr (FT1536.GameByte.signName r msg)) m.st).1))
'FT1536.GameMach.step_eq' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
