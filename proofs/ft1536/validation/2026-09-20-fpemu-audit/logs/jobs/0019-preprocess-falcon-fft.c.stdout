void
falcon_poly_split_top_fft3(
 fpr *restrict f0, fpr *restrict f1, fpr *restrict f2,
 const fpr *restrict f, unsigned logn)
{
 size_t n, hn, qn, u, v;

 n = (size_t)3 << (logn - 1);
 hn = n >> 1;
 qn = (size_t)1 << (logn - 2);
 for (u = 0, v = 0; u < hn; u += 3, v ++) {
  fpr fAr, fAi, fBr, fBi, fCr, fCi, xr, xi;
  fpr fB1r, fB1i, fB2r, fB2i, fC1r, fC1i, fC2r, fC2i;
  fpr t0r, t0i, t1r, t1i, t2r, t2i;

  fAr = f[u];
  fAi = f[u + hn];
  fBr = f[u + 1];
  fBi = f[u + 1 + hn];
  fCr = f[u + 2];
  fCi = f[u + 2 + hn];

  xr = fpr_gm3_cubic[(v << 1) + ((size_t)1 << logn) + 0];
  xi = fpr_neg(fpr_gm3_cubic[(v << 1) + ((size_t)1 << logn) + 1]);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fBr); fpct_a_im = (fBi); fpct_b_re = (fpr_W4R); fpct_b_im = (fpr_W4I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fB1r) = fpct_d_re; (fB1i) = fpct_d_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fBr); fpct_a_im = (fBi); fpct_b_re = (fpr_W2R); fpct_b_im = (fpr_W2I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fB2r) = fpct_d_re; (fB2i) = fpct_d_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fCr); fpct_a_im = (fCi); fpct_b_re = (fpr_W4R); fpct_b_im = (fpr_W4I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fC1r) = fpct_d_re; (fC1i) = fpct_d_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fCr); fpct_a_im = (fCi); fpct_b_re = (fpr_W2R); fpct_b_im = (fpr_W2I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fC2r) = fpct_d_re; (fC2i) = fpct_d_im; } while (0);

  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fBr, fCr); fpct_im = fpr_add(fBi, fCi); (fBr) = fpct_re; (fBi) = fpct_im; } while (0);
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fAr, fBr); fpct_im = fpr_add(fAi, fBi); (t0r) = fpct_re; (t0i) = fpct_im; } while (0);

  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fB1r, fC2r); fpct_im = fpr_add(fB1i, fC2i); (fB1r) = fpct_re; (fB1i) = fpct_im; } while (0);
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fB1r, fAr); fpct_im = fpr_add(fB1i, fAi); (fB1r) = fpct_re; (fB1i) = fpct_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (xr); fpct_a_im = (xi); fpct_b_re = (fB1r); fpct_b_im = (fB1i); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (t1r) = fpct_d_re; (t1i) = fpct_d_im; } while (0);

  do { fpr fpct_a_re, fpct_a_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (xr); fpct_a_im = (xi); fpct_d_re = fpr_sub(fpr_sqr(fpct_a_re), fpr_sqr(fpct_a_im)); fpct_d_im = fpr_double(fpr_mul(fpct_a_re, fpct_a_im)); (xr) = fpct_d_re; (xi) = fpct_d_im; } while (0);
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fB2r, fC1r); fpct_im = fpr_add(fB2i, fC1i); (fB2r) = fpct_re; (fB2i) = fpct_im; } while (0);
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fB2r, fAr); fpct_im = fpr_add(fB2i, fAi); (fB2r) = fpct_re; (fB2i) = fpct_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (xr); fpct_a_im = (xi); fpct_b_re = (fB2r); fpct_b_im = (fB2i); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (t2r) = fpct_d_re; (t2i) = fpct_d_im; } while (0);

  f0[v] = fpr_mul(t0r, fpr_inverse_of(3));
  f0[v + qn] = fpr_mul(t0i, fpr_inverse_of(3));
  f1[v] = fpr_mul(t1r, fpr_inverse_of(3));
  f1[v + qn] = fpr_mul(t1i, fpr_inverse_of(3));
  f2[v] = fpr_mul(t2r, fpr_inverse_of(3));
  f2[v + qn] = fpr_mul(t2i, fpr_inverse_of(3));
 }
}


void
falcon_poly_split_deep_fft3(fpr *restrict f0, fpr *restrict f1,
 const fpr *restrict f, unsigned logn)
{
 size_t n, hn, qn, u, m;




 if (logn == 1) {
  fpr re, im, xx;

  re = f[0];
  im = f[1];
  xx = fpr_mul(fpr_IW1I, im);
  *f1 = xx;
  *f0 = fpr_sub(re, fpr_half(xx));
  return;
 }

 n = (size_t)1 << logn;
 hn = n >> 1;
 qn = hn >> 1;

 m = (size_t)1 << (logn - 1);
 for (u = 0; u < qn; u ++) {
  fpr a_re, a_im, b_re, b_im;
  fpr t_re, t_im;

  a_re = f[(u << 1) + 0];
  a_im = f[(u << 1) + 0 + hn];
  b_re = f[(u << 1) + 1];
  b_im = f[(u << 1) + 1 + hn];

  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(a_re, b_re); fpct_im = fpr_add(a_im, b_im); (t_re) = fpct_re; (t_im) = fpct_im; } while (0);
  f0[u] = fpr_half(t_re);
  f0[u + qn] = fpr_half(t_im);

  do { fpr fpct_re, fpct_im; fpct_re = fpr_sub(a_re, b_re); fpct_im = fpr_sub(a_im, b_im); (t_re) = fpct_re; (t_im) = fpct_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (t_re); fpct_a_im = (t_im); fpct_b_re = (fpr_gm3_square[((u + m) << 1) + 0]); fpct_b_im = (fpr_neg(fpr_gm3_square[((u + m) << 1) + 1])); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (t_re) = fpct_d_re; (t_im) = fpct_d_im; } while (0)

                                               ;
  f1[u] = fpr_half(t_re);
  f1[u + qn] = fpr_half(t_im);
 }
}


void
falcon_poly_merge_top_fft3(fpr *restrict f,
 const fpr *restrict f0, const fpr *restrict f1, const fpr *restrict f2,
 unsigned logn)
{
 size_t n, hn, qn, u, v;

 n = (size_t)3 << (logn - 1);
 hn = n >> 1;
 qn = (size_t)1 << (logn - 2);
 for (u = 0, v = 0; u < hn; u += 3, v ++) {
  fpr fAr, fAi, fBr, fBi, fCr, fCi;
  fpr xr, xi;
  fpr fB0r, fB0i, fB1r, fB1i, fB2r, fB2i;
  fpr fC0r, fC0i, fC1r, fC1i, fC2r, fC2i;

  fAr = f0[v];
  fAi = f0[v + qn];
  fBr = f1[v];
  fBi = f1[v + qn];
  fCr = f2[v];
  fCi = f2[v + qn];

  xr = fpr_gm3_cubic[(v << 1) + ((size_t)1 << logn) + 0];
  xi = fpr_gm3_cubic[(v << 1) + ((size_t)1 << logn) + 1];
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fBr); fpct_a_im = (fBi); fpct_b_re = (xr); fpct_b_im = (xi); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fB0r) = fpct_d_re; (fB0i) = fpct_d_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fB0r); fpct_a_im = (fB0i); fpct_b_re = (fpr_W2R); fpct_b_im = (fpr_W2I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fB1r) = fpct_d_re; (fB1i) = fpct_d_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fB0r); fpct_a_im = (fB0i); fpct_b_re = (fpr_W4R); fpct_b_im = (fpr_W4I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fB2r) = fpct_d_re; (fB2i) = fpct_d_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (xr); fpct_a_im = (xi); fpct_d_re = fpr_sub(fpr_sqr(fpct_a_re), fpr_sqr(fpct_a_im)); fpct_d_im = fpr_double(fpr_mul(fpct_a_re, fpct_a_im)); (xr) = fpct_d_re; (xi) = fpct_d_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fCr); fpct_a_im = (fCi); fpct_b_re = (xr); fpct_b_im = (xi); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fC0r) = fpct_d_re; (fC0i) = fpct_d_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fC0r); fpct_a_im = (fC0i); fpct_b_re = (fpr_W2R); fpct_b_im = (fpr_W2I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fC1r) = fpct_d_re; (fC1i) = fpct_d_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fC0r); fpct_a_im = (fC0i); fpct_b_re = (fpr_W4R); fpct_b_im = (fpr_W4I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fC2r) = fpct_d_re; (fC2i) = fpct_d_im; } while (0);
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fB0r, fC0r); fpct_im = fpr_add(fB0i, fC0i); (fB0r) = fpct_re; (fB0i) = fpct_im; } while (0);
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fB1r, fC2r); fpct_im = fpr_add(fB1i, fC2i); (fB1r) = fpct_re; (fB1i) = fpct_im; } while (0);
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fB2r, fC1r); fpct_im = fpr_add(fB2i, fC1i); (fB2r) = fpct_re; (fB2i) = fpct_im; } while (0);
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fAr, fB0r); fpct_im = fpr_add(fAi, fB0i); (f[u + 0]) = fpct_re; (f[u + 0 + hn]) = fpct_im; } while (0);
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fAr, fB1r); fpct_im = fpr_add(fAi, fB1i); (f[u + 1]) = fpct_re; (f[u + 1 + hn]) = fpct_im; } while (0);
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fAr, fB2r); fpct_im = fpr_add(fAi, fB2i); (f[u + 2]) = fpct_re; (f[u + 2 + hn]) = fpct_im; } while (0);
 }
}


void
falcon_poly_merge_deep_fft3(fpr *restrict f,
 const fpr *restrict f0, const fpr *restrict f1, unsigned logn)
{
 size_t n, hn, qn, u, m;




 if (logn == 1) {
  fpr x, y;

  x = *f0;
  y = *f1;
  f[0] = fpr_add(x, fpr_mul(y, fpr_W1R));
  f[1] = fpr_mul(y, fpr_W1I);
  return;
 }

 n = (size_t)1 << logn;
 hn = n >> 1;
 qn = hn >> 1;

 m = (size_t)1 << (logn - 1);
 for (u = 0; u < qn; u ++) {
  fpr a_re, a_im, b_re, b_im;
  fpr t_re, t_im;

  a_re = f0[u];
  a_im = f0[u + qn];
  b_re = f1[u];
  b_im = f1[u + qn];
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (b_re); fpct_a_im = (b_im); fpct_b_re = (fpr_gm3_square[((u + m) << 1) + 0]); fpct_b_im = (fpr_gm3_square[((u + m) << 1) + 1]); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (t_re) = fpct_d_re; (t_im) = fpct_d_im; } while (0)

                                      ;
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(a_re, t_re); fpct_im = fpr_add(a_im, t_im); (f[(u << 1) + 0]) = fpct_re; (f[(u << 1) + 0 + hn]) = fpct_im; } while (0)
                          ;
  do { fpr fpct_re, fpct_im; fpct_re = fpr_sub(a_re, t_re); fpct_im = fpr_sub(a_im, t_im); (f[(u << 1) + 1]) = fpct_re; (f[(u << 1) + 1 + hn]) = fpct_im; } while (0)
                          ;
 }
}
