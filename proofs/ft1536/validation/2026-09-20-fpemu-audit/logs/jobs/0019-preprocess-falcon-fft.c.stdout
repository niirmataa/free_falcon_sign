# 39 "inputs/bootstrap/source/falcon-fft.c" 2
# 175 "inputs/bootstrap/source/falcon-fft.c"
void
falcon_FFT(fpr *f, unsigned logn)
{
# 207 "inputs/bootstrap/source/falcon-fft.c"
 unsigned u;
 size_t t, n, hn, m;
# 221 "inputs/bootstrap/source/falcon-fft.c"
 n = (size_t)1 << logn;
 hn = n >> 1;
 t = hn;
 for (u = 1, m = 2; u < logn; u ++, m <<= 1) {
  size_t ht, hm, i1, j1;

  ht = t >> 1;
  hm = m >> 1;
  for (i1 = 0, j1 = 0; i1 < hm; i1 ++, j1 += t) {
   unsigned j, j2;
   fpr s_re, s_im;

   s_re = fpr_gm_tab[((m + i1) << 1) + 0];
   s_im = fpr_gm_tab[((m + i1) << 1) + 1];
   j2 = j1 + ht;
   for (j = j1; j < j2; j ++) {
    fpr x_re, x_im, y_re, y_im;

    x_re = f[j];
    x_im = f[j + hn];
    y_re = f[j + ht];
    y_im = f[j + ht + hn];
    do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (y_re); fpct_a_im = (y_im); fpct_b_re = (s_re); fpct_b_im = (s_im); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (y_re) = fpct_d_re; (y_im) = fpct_d_im; } while (0);
    do { fpr fpct_re, fpct_im; fpct_re = fpr_add(x_re, y_re); fpct_im = fpr_add(x_im, y_im); (f[j]) = fpct_re; (f[j + hn]) = fpct_im; } while (0)
                            ;
    do { fpr fpct_re, fpct_im; fpct_re = fpr_sub(x_re, y_re); fpct_im = fpr_sub(x_im, y_im); (f[j + ht]) = fpct_re; (f[j + ht + hn]) = fpct_im; } while (0)
                            ;
   }
  }
  t = ht;
 }
}


void
falcon_iFFT(fpr *f, unsigned logn)
{
# 300 "inputs/bootstrap/source/falcon-fft.c"
 size_t u, n, hn, t, m;

 n = (size_t)1 << logn;
 t = 1;
 m = n;
 hn = n >> 1;
 for (u = logn; u > 1; u --) {
  size_t hm, dt, i1, j1;

  hm = m >> 1;
  dt = t << 1;
  for (i1 = 0, j1 = 0; j1 < hn; i1 ++, j1 += dt) {
   size_t j, j2;
   fpr s_re, s_im;

   j2 = j1 + t;
   s_re = fpr_gm_tab[((hm + i1) << 1) + 0];
   s_im = fpr_neg(fpr_gm_tab[((hm + i1) << 1) + 1]);
   for (j = j1; j < j2; j ++) {
    fpr x_re, x_im, y_re, y_im;

    x_re = f[j];
    x_im = f[j + hn];
    y_re = f[j + t];
    y_im = f[j + t + hn];
    do { fpr fpct_re, fpct_im; fpct_re = fpr_add(x_re, y_re); fpct_im = fpr_add(x_im, y_im); (f[j]) = fpct_re; (f[j + hn]) = fpct_im; } while (0)
                            ;
    do { fpr fpct_re, fpct_im; fpct_re = fpr_sub(x_re, y_re); fpct_im = fpr_sub(x_im, y_im); (x_re) = fpct_re; (x_im) = fpct_im; } while (0);
    do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (x_re); fpct_a_im = (x_im); fpct_b_re = (s_re); fpct_b_im = (s_im); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (f[j + t]) = fpct_d_re; (f[j + t + hn]) = fpct_d_im; } while (0)
                            ;
   }
  }
  t = dt;
  m = hm;
 }





 if (logn > 0) {
  fpr ni;

  ni = fpr_scaled(2, -(int)logn);
  for (u = 0; u < n; u ++) {
   f[u] = fpr_mul(f[u], ni);
  }
 }
}


void
falcon_poly_add(fpr *restrict a, const fpr *restrict b, unsigned logn)
{
 size_t n, u;

 n = (size_t)1 << logn;
 for (u = 0; u < n; u ++) {
  a[u] = fpr_add(a[u], b[u]);
 }
}


void
falcon_poly_addconst(fpr *a, fpr x, unsigned logn)
{
 (void)logn;
 a[0] = fpr_add(a[0], x);
}


void
falcon_poly_addconst_fft(fpr *a, fpr x, unsigned logn)
{
 size_t hn, u;

 hn = (size_t)1 << (logn - 1);
 for (u = 0; u < hn; u ++) {
  a[u] = fpr_add(a[u], x);
 }
}


void
falcon_poly_sub(fpr *restrict a, const fpr *restrict b, unsigned logn)
{
 size_t n, u;

 n = (size_t)1 << logn;
 for (u = 0; u < n; u ++) {
  a[u] = fpr_sub(a[u], b[u]);
 }
}


void
falcon_poly_neg(fpr *a, unsigned logn)
{
 size_t n, u;

 n = (size_t)1 << logn;
 for (u = 0; u < n; u ++) {
  a[u] = fpr_neg(a[u]);
 }
}


void
falcon_poly_adj(fpr *a, unsigned logn)
{
 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 1; u < hn; u ++) {
  fpr t;

  t = fpr_neg(a[u]);
  a[u] = fpr_neg(a[n - u]);
  a[n - u] = t;
 }
 a[hn] = fpr_neg(a[hn]);
}


void
falcon_poly_adj_fft(fpr *a, unsigned logn)
{
 size_t n, u;

 n = (size_t)1 << logn;
 for (u = (n >> 1); u < n; u ++) {
  a[u] = fpr_neg(a[u]);
 }
}


void
falcon_poly_mul_fft(fpr *restrict a, const fpr *restrict b, unsigned logn)
{
 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 0; u < hn; u ++) {
  fpr a_re, a_im, b_re, b_im;

  a_re = a[u];
  a_im = a[u + hn];
  b_re = b[u];
  b_im = b[u + hn];
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (a_re); fpct_a_im = (a_im); fpct_b_re = (b_re); fpct_b_im = (b_im); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (a[u]) = fpct_d_re; (a[u + hn]) = fpct_d_im; } while (0);
 }
}


void
falcon_poly_sqr_fft(fpr *a, unsigned logn)
{
 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 0; u < hn; u ++) {
  fpr a_re, a_im;

  a_re = a[u];
  a_im = a[u + hn];
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (a_re); fpct_a_im = (a_im); fpct_d_re = fpr_sub(fpr_sqr(fpct_a_re), fpr_sqr(fpct_a_im)); fpct_d_im = fpr_double(fpr_mul(fpct_a_re, fpct_a_im)); (a[u]) = fpct_d_re; (a[u + hn]) = fpct_d_im; } while (0);
 }
}


void
falcon_poly_muladj_fft(fpr *restrict a, const fpr *restrict b, unsigned logn)
{
 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 0; u < hn; u ++) {
  fpr a_re, a_im, b_re, b_im;

  a_re = a[u];
  a_im = a[u + hn];
  b_re = b[u];
  b_im = fpr_neg(b[u + hn]);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (a_re); fpct_a_im = (a_im); fpct_b_re = (b_re); fpct_b_im = (b_im); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (a[u]) = fpct_d_re; (a[u + hn]) = fpct_d_im; } while (0);
 }
}


void
falcon_poly_mulselfadj_fft(fpr *a, unsigned logn)
{




 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 0; u < hn; u ++) {
  fpr a_re, a_im;

  a_re = a[u];
  a_im = a[u + hn];
  a[u] = fpr_add(fpr_sqr(a_re), fpr_sqr(a_im));
  a[u + hn] = fpr_of(0);
 }
}


void
falcon_poly_mulconst(fpr *a, fpr x, unsigned logn)
{
 size_t n, u;

 n = (size_t)1 << logn;
 for (u = 0; u < n; u ++) {
  a[u] = fpr_mul(a[u], x);
 }
}


void
falcon_poly_inv_fft(fpr *a, unsigned logn)
{
 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 0; u < hn; u ++) {
  fpr a_re, a_im;

  a_re = a[u];
  a_im = a[u + hn];
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_d_re, fpct_d_im; fpr fpct_m; fpct_a_re = (a_re); fpct_a_im = (a_im); fpct_m = fpr_add(fpr_sqr(fpct_a_re), fpr_sqr(fpct_a_im)); fpct_d_re = fpr_div(fpct_a_re, fpct_m); fpct_d_im = fpr_div(fpr_neg(fpct_a_im), fpct_m); (a[u]) = fpct_d_re; (a[u + hn]) = fpct_d_im; } while (0);
 }
}


void
falcon_poly_div_fft(fpr *restrict a, const fpr *restrict b, unsigned logn)
{
 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 0; u < hn; u ++) {
  fpr a_re, a_im, b_re, b_im;

  a_re = a[u];
  a_im = a[u + hn];
  b_re = b[u];
  b_im = b[u + hn];
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpr fpct_m; fpct_a_re = (a_re); fpct_a_im = (a_im); fpct_b_re = (b_re); fpct_b_im = (b_im); fpct_m = fpr_add(fpr_sqr(fpct_b_re), fpr_sqr(fpct_b_im)); fpct_b_re = fpr_div(fpct_b_re, fpct_m); fpct_b_im = fpr_div(fpr_neg(fpct_b_im), fpct_m); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (a[u]) = fpct_d_re; (a[u + hn]) = fpct_d_im; } while (0);
 }
}


void
falcon_poly_divadj_fft(fpr *restrict a, const fpr *restrict b, unsigned logn)
{
 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 0; u < hn; u ++) {
  fpr a_re, a_im, b_re, b_im;

  a_re = a[u];
  a_im = a[u + hn];
  b_re = b[u];
  b_im = fpr_neg(b[u + hn]);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpr fpct_m; fpct_a_re = (a_re); fpct_a_im = (a_im); fpct_b_re = (b_re); fpct_b_im = (b_im); fpct_m = fpr_add(fpr_sqr(fpct_b_re), fpr_sqr(fpct_b_im)); fpct_b_re = fpr_div(fpct_b_re, fpct_m); fpct_b_im = fpr_div(fpr_neg(fpct_b_im), fpct_m); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (a[u]) = fpct_d_re; (a[u + hn]) = fpct_d_im; } while (0);
 }
}


void
falcon_poly_invnorm2_fft(fpr *restrict d,
 const fpr *restrict a, const fpr *restrict b, unsigned logn)
{
 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 0; u < hn; u ++) {
  fpr a_re, a_im;
  fpr b_re, b_im;

  a_re = a[u];
  a_im = a[u + hn];
  b_re = b[u];
  b_im = b[u + hn];
  d[u] = fpr_inv(fpr_add(
   fpr_add(fpr_sqr(a_re), fpr_sqr(a_im)),
   fpr_add(fpr_sqr(b_re), fpr_sqr(b_im))));
 }
}


void
falcon_poly_add_muladj_fft(fpr *restrict d,
 const fpr *restrict F, const fpr *restrict G,
 const fpr *restrict f, const fpr *restrict g, unsigned logn)
{
 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 0; u < hn; u ++) {
  fpr F_re, F_im, G_re, G_im;
  fpr f_re, f_im, g_re, g_im;
  fpr a_re, a_im, b_re, b_im;

  F_re = F[u];
  F_im = F[u + hn];
  G_re = G[u];
  G_im = G[u + hn];
  f_re = f[u];
  f_im = f[u + hn];
  g_re = g[u];
  g_im = g[u + hn];

  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (F_re); fpct_a_im = (F_im); fpct_b_re = (f_re); fpct_b_im = (fpr_neg(f_im)); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (a_re) = fpct_d_re; (a_im) = fpct_d_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (G_re); fpct_a_im = (G_im); fpct_b_re = (g_re); fpct_b_im = (fpr_neg(g_im)); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (b_re) = fpct_d_re; (b_im) = fpct_d_im; } while (0);
  d[u] = fpr_add(a_re, b_re);
  d[u + hn] = fpr_add(a_im, b_im);
 }
}


void
falcon_poly_mul_autoadj_fft(fpr *restrict a,
 const fpr *restrict b, unsigned logn)
{
 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 0; u < hn; u ++) {
  a[u] = fpr_mul(a[u], b[u]);
  a[u + hn] = fpr_mul(a[u + hn], b[u]);
 }
}


void
falcon_poly_div_autoadj_fft(fpr *restrict a,
 const fpr *restrict b, unsigned logn)
{
 size_t n, hn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 for (u = 0; u < hn; u ++) {
  a[u] = fpr_div(a[u], b[u]);
  a[u + hn] = fpr_div(a[u + hn], b[u]);
 }
}


void
falcon_poly_split_fft(fpr *restrict f0, fpr *restrict f1,
 const fpr *restrict f, unsigned logn)
{






 size_t n, hn, qn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 qn = hn >> 1;







 f0[0] = f[0];
 f1[0] = f[hn];

 for (u = 0; u < qn; u ++) {
  fpr a_re, a_im, b_re, b_im;
  fpr t_re, t_im;

  a_re = f[(u << 1) + 0];
  a_im = f[(u << 1) + 0 + hn];
  b_re = f[(u << 1) + 1];
  b_im = f[(u << 1) + 1 + hn];

  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(a_re, b_re); fpct_im = fpr_add(a_im, b_im); (t_re) = fpct_re; (t_im) = fpct_im; } while (0);
  f0[u] = fpr_half(t_re);
  f0[u + qn] = fpr_half(t_im);

  do { fpr fpct_re, fpct_im; fpct_re = fpr_sub(a_re, b_re); fpct_im = fpr_sub(a_im, b_im); (t_re) = fpct_re; (t_im) = fpct_im; } while (0);
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (t_re); fpct_a_im = (t_im); fpct_b_re = (fpr_gm_tab[((u + hn) << 1) + 0]); fpct_b_im = (fpr_neg(fpr_gm_tab[((u + hn) << 1) + 1])); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (t_re) = fpct_d_re; (t_im) = fpct_d_im; } while (0)

                                            ;
  f1[u] = fpr_half(t_re);
  f1[u + qn] = fpr_half(t_im);
 }
}


void
falcon_poly_merge_fft(fpr *restrict f,
 const fpr *restrict f0, const fpr *restrict f1, unsigned logn)
{
 size_t n, hn, qn, u;

 n = (size_t)1 << logn;
 hn = n >> 1;
 qn = hn >> 1;




 f[0] = f0[0];
 f[hn] = f1[0];

 for (u = 0; u < qn; u ++) {
  fpr a_re, a_im, b_re, b_im;
  fpr t_re, t_im;

  a_re = f0[u];
  a_im = f0[u + qn];
  do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (f1[u]); fpct_a_im = (f1[u + qn]); fpct_b_re = (fpr_gm_tab[((u + hn) << 1) + 0]); fpct_b_im = (fpr_gm_tab[((u + hn) << 1) + 1]); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (b_re) = fpct_d_re; (b_im) = fpct_d_im; } while (0)

                                   ;
  do { fpr fpct_re, fpct_im; fpct_re = fpr_add(a_re, b_re); fpct_im = fpr_add(a_im, b_im); (t_re) = fpct_re; (t_im) = fpct_im; } while (0);
  f[(u << 1) + 0] = t_re;
  f[(u << 1) + 0 + hn] = t_im;
  do { fpr fpct_re, fpct_im; fpct_re = fpr_sub(a_re, b_re); fpct_im = fpr_sub(a_im, b_im); (t_re) = fpct_re; (t_im) = fpct_im; } while (0);
  f[(u << 1) + 1] = t_re;
  f[(u << 1) + 1 + hn] = t_im;
 }
}
# 758 "inputs/bootstrap/source/falcon-fft.c"
void
falcon_FFT3(fpr *a, unsigned logn, unsigned full)
{
 size_t n, hn, u, t, tmin, m;

 n = ((size_t)(1 + ((full) << 1)) << ((logn) - (full)));
 hn = n >> 1;






 for (u = 0; u < hn; u ++) {
  fpr a0, a1;

  a0 = a[u];
  a1 = a[u + hn];
  a[u] = fpr_add(a0, fpr_mul(a1, fpr_W1R));
  a[u + hn] = fpr_mul(a1, fpr_W1I);
 }




 t = hn;
 tmin = 1 + (full << 1);
 for (m = 2; t > tmin; m <<= 1) {
  size_t ht, hm, u1, v1;

  ht = t >> 1;
  hm = m >> 1;
  for (u1 = 0, v1 = 0; u1 < hm; u1 ++, v1 += t) {
   size_t v, v2;
   fpr sr, si;

   sr = fpr_gm3_square[((m + u1) << 1) + 0];
   si = fpr_gm3_square[((m + u1) << 1) + 1];
   v2 = v1 + ht;
   for (v = v1; v < v2; v ++) {
    fpr a0r, a0i, a1r, a1i;

    a0r = a[v];
    a0i = a[v + hn];
    a1r = a[v + ht];
    a1i = a[v + ht + hn];
    do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (a1r); fpct_a_im = (a1i); fpct_b_re = (sr); fpct_b_im = (si); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (a1r) = fpct_d_re; (a1i) = fpct_d_im; } while (0);
    do { fpr fpct_re, fpct_im; fpct_re = fpr_add(a0r, a1r); fpct_im = fpr_add(a0i, a1i); (a[v]) = fpct_re; (a[v + hn]) = fpct_im; } while (0)
                        ;
    do { fpr fpct_re, fpct_im; fpct_re = fpr_sub(a0r, a1r); fpct_im = fpr_sub(a0i, a1i); (a[v + ht]) = fpct_re; (a[v + ht + hn]) = fpct_im; } while (0)
                        ;
   }
  }
  t = ht;
 }




 if (full) {
  size_t v;

  for (u = 0, v = (size_t)1 << logn; u < hn; u += 3, v += 2) {
   fpr fAr, fAi, fBr, fBi, fCr, fCi;
   fpr xr, xi;
   fpr fB0r, fB0i, fB1r, fB1i, fB2r, fB2i;
   fpr fC0r, fC0i, fC1r, fC1i, fC2r, fC2i;

   fAr = a[u];
   fAi = a[u + hn];
   fBr = a[u + 1];
   fBi = a[u + 1 + hn];
   fCr = a[u + 2];
   fCi = a[u + 2 + hn];

   xr = fpr_gm3_cubic[v + 0];
   xi = fpr_gm3_cubic[v + 1];
   do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fBr); fpct_a_im = (fBi); fpct_b_re = (xr); fpct_b_im = (xi); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fB0r) = fpct_d_re; (fB0i) = fpct_d_im; } while (0);
   do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fB0r); fpct_a_im = (fB0i); fpct_b_re = (fpr_W2R); fpct_b_im = (fpr_W2I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fB1r) = fpct_d_re; (fB1i) = fpct_d_im; } while (0);
   do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fB0r); fpct_a_im = (fB0i); fpct_b_re = (fpr_W4R); fpct_b_im = (fpr_W4I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fB2r) = fpct_d_re; (fB2i) = fpct_d_im; } while (0);
   do { fpr fpct_a_re, fpct_a_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (xr); fpct_a_im = (xi); fpct_d_re = fpr_sub(fpr_sqr(fpct_a_re), fpr_sqr(fpct_a_im)); fpct_d_im = fpr_double(fpr_mul(fpct_a_re, fpct_a_im)); (xr) = fpct_d_re; (xi) = fpct_d_im; } while (0);
   do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fCr); fpct_a_im = (fCi); fpct_b_re = (xr); fpct_b_im = (xi); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fC0r) = fpct_d_re; (fC0i) = fpct_d_im; } while (0);
   do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fC0r); fpct_a_im = (fC0i); fpct_b_re = (fpr_W2R); fpct_b_im = (fpr_W2I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fC1r) = fpct_d_re; (fC1i) = fpct_d_im; } while (0);
   do { fpr fpct_a_re, fpct_a_im; fpr fpct_b_re, fpct_b_im; fpr fpct_d_re, fpct_d_im; fpct_a_re = (fC0r); fpct_a_im = (fC0i); fpct_b_re = (fpr_W4R); fpct_b_im = (fpr_W4I); fpct_d_re = fpr_sub( fpr_mul(fpct_a_re, fpct_b_re), fpr_mul(fpct_a_im, fpct_b_im)); fpct_d_im = fpr_add( fpr_mul(fpct_a_re, fpct_b_im), fpr_mul(fpct_a_im, fpct_b_re)); (fC2r) = fpct_d_re; (fC2i) = fpct_d_im; } while (0);
   do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fB0r, fC0r); fpct_im = fpr_add(fB0i, fC0i); (fB0r) = fpct_re; (fB0i) = fpct_im; } while (0);
   do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fB1r, fC2r); fpct_im = fpr_add(fB1i, fC2i); (fB1r) = fpct_re; (fB1i) = fpct_im; } while (0);
   do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fB2r, fC1r); fpct_im = fpr_add(fB2i, fC1i); (fB2r) = fpct_re; (fB2i) = fpct_im; } while (0);
   do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fAr, fB0r); fpct_im = fpr_add(fAi, fB0i); (a[u + 0]) = fpct_re; (a[u + 0 + hn]) = fpct_im; } while (0);
   do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fAr, fB1r); fpct_im = fpr_add(fAi, fB1i); (a[u + 1]) = fpct_re; (a[u + 1 + hn]) = fpct_im; } while (0);
   do { fpr fpct_re, fpct_im; fpct_re = fpr_add(fAr, fB2r); fpct_im = fpr_add(fAi, fB2i); (a[u + 2]) = fpct_re; (a[u + 2 + hn]) = fpct_im; } while (0);
  }
 }
}


void
falcon_iFFT3(fpr *a, unsigned logn, unsigned full)
{
 size_t n, hn, u, t, m;
 fpr ni;

 n = ((size_t)(1 + ((full) << 1)) << ((logn) - (full)));
 hn = n >> 1;




 if (full) {
  size_t v;

  for (u = 0, v = (size_t)1 << logn; u < hn; u += 3, v += 2) {
   fpr f0r, f0i, f1r, f1i, f2r, f2i, xr, xi;
   fpr f11r, f11i, f12r, f12i, f21r, f21i, f22r, f22i;

   f0r = a[u];
   f0i = a[u + hn];
   f1r = a[u + 1];
   f1i = a[u + 1 + hn];
   f2r = a[u + 2];
   f2i = a[u + 2 + hn];

   xr = fpr_gm3_cubic[v + 0];
