  CanonVec h →
    CanonVec c →
      SignedVec s →
        rawVerify (prepareKey h) c s = true →
          SignedVec (Ext0Words h c s).fst ∧
            Congruent h c (Ext0Words h c s) ∧ Q (Ext0Words h c s).fst (Ext0Words h c s).snd < 2093922385 :=
fun h c s hh hc hs accept =>
  have hn := (STRICT_B (rawFirst (prepareKey h) c s) s (raw_signed (prepareKey h) c s) hs).mp accept;
