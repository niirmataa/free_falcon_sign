leaf_facts : ∀ (b : Nat),
  b < 512 →
    ∀ (j : Fin 3),
      have pos := 3 * b;
      have z := node b j;
      z ^ 768 % 18433 = rootLabel pos % 18433 ∧
        (∀ (p : Nat × Nat),
            p ∈ forwardSchedule 9 2 768 → z ^ (p.snd / 2) % 18433 = splitLabel p.fst (p.snd / 2) pos % 18433) ∧
          PhiZero z ∧ ∀ (k : Fin 3), (cubeFExpr (gmAt (512 + b)) fW j).eval (basis k) = z ^ ↑k % 18433
'FT1536Forward.leaf_facts' depends on axioms: [propext, Quot.sound]
