middle_eval : ∀ (ps : List (Nat × Nat)) (t : Nat),
  StageChain t ps →
    ∀ (pos : Nat),
      pos < 1536 →
        ∀ (z : Int),
          (∀ (p : Nat × Nat), p ∈ ps → z ^ (p.snd / 2) % 18433 = splitLabel p.fst (p.snd / 2) pos % 18433) →
            ∀ (s : Mem), blockEval 3 (blockBase 3 pos) (forwardMiddle ps s) z = blockEval t (blockBase t pos) s z
