"""Deterministic claims and receipts (T02.1): LAYOUT.json,
RESOURCE_INTERFACE.json, PRNG_LAYOUT_CERTIFICATE.json, RESULT.json,
TOOLCHAIN.txt and INPUTS.sha256.

The JSON/TXT outputs are deliberately path-free so the fresh replay
recomputes them byte-identically in its own DEST.  INPUTS.sha256 keeps
absolute provenance paths (non-semantic, like the input receipts).
"""
import json,platform,subprocess
from pathlib import Path
from replaylib import sha
from common import W
A=W/'artifacts'
TASK_SHA='7b0007c095c51b1fe4c5d94b0b1a0012227aba4df0d1c59cfa8fcd92589fe5f1'
RULE_SHA='b6afcdcabb811dd8bc31072455ed9a94a4c4773ec68d41d207ac1d7e98eae241'
MANIFEST_SHA='03b0612cbe3b18e487bee6399c71c238e5ff3a0527818a7c4330d007b72abae2'
BASE='c90233c171265e050930958fb29bafa9338f81ff'
FRNG_SHA='4b1289adf0c902abe9408d989b4eb8d292cbb6ea86b92e1325a10fd9c5dfc644'
INTERNAL_SHA='512629d3b79fa5bd74131ed2ecde06e1d157f5ac58db3f758db96b19131f1ba5'
STATUS='PRNG_LAYOUT_COUNTER_PROVED_FOR_PINNED_SOURCE_MODEL'
SEMANTIC=['artifacts/fixtures.bin','artifacts/fixtures.json','artifacts/kat_vectors.json',
 'artifacts/harness_dump.json','artifacts/harness_dump_sanitized.json',
 'artifacts/harness_dump_altbranch.json','artifacts/model_dump.json',
 'artifacts/model_result.json','artifacts/mutations.json','artifacts/checker_result.json',
 'LAYOUT.json','RESOURCE_INTERFACE.json','PRNG_LAYOUT_CERTIFICATE.json','RESULT.json','TOOLCHAIN.txt']
def first_line(argv):
    p=subprocess.run(argv,capture_output=True,text=True,timeout=300,check=True)
    return (p.stdout+p.stderr).strip().splitlines()[0]
def main():
    model=json.loads((A/'model_result.json').read_text())
    checker=json.loads((A/'checker_result.json').read_text())
    muts=json.loads((A/'mutations.json').read_text())
    kat=json.loads((A/'kat_vectors.json').read_text())
    harness=json.loads((A/'harness_dump.json').read_text())
    assert checker['status']=='PASS' and checker['checks']==len(checker['checks_list'])
    killed=[m['id'] for m in muts['mutations'] if m['kind']=='MEANINGFUL']
    noops=[m['id'] for m in muts['mutations'] if m['kind']=='NO_OP_BY_CONSTRUCTION']
    assert len(killed)==6 and len(noops)==2
    layout=dict(schema='PRNG_T021_LAYOUT_V1',task_id='FT1536_PRNG_LAYOUT_COUNTER_RUN_001',
        roadmap_id='T02.1',base_commit=BASE,
        source_pins=dict(frng_c=FRNG_SHA,internal_h=INTERNAL_SHA),
        pinned_abi=dict(model='GCC 14.2 / C99 driver / x86_64 LP64 / FALCON_LE_U=1',
                        **{k:harness['layout'][k] for k in sorted(harness['layout'])}),
        map=model['layout'],
        fixture_binding=dict(fixtures=7,stages=21,
            note='whole 4096-byte buffer and 256-byte state compared field-by-field; see artifacts/checker_result.json'))
    (W/'LAYOUT.json').write_text(json.dumps(layout,indent=2)+'\n')
    res=model['resources']
    resource=dict(schema='PRNG_T021_RESOURCE_INTERFACE_V1',
        event='H from T01: every reached context has T_j<=49152, r_j<=396, J<=16',
        derived=dict(r_max=res['r_max'],blocks_per_reached_context=res['blocks_per_reached_context'],
            additional_refills_limit=res['additional_refills_limit'],
            region_block_evaluations=res['region_block_evaluations'],
            requested_parent_SHAKE56_bytes=res['requested_parent_SHAKE56_bytes'],
            with_nonce40_upper=res['with_nonce40_upper']),
        received_T01=res['received_T01'],
        q_refill=model['q_refill'],
        block_size=64,buffer_size=4096,refill_blocks=64,
        scope='deterministic consumer of the received T01 event; no re-proof of T01/H6P and no real-game probability claim')
    (W/'RESOURCE_INTERFACE.json').write_text(json.dumps(resource,indent=2)+'\n')
    proof_files={p:sha(W/p) for p in SEMANTIC if p not in ('PRNG_LAYOUT_CERTIFICATE.json','RESULT.json','TOOLCHAIN.txt')}
    cert=dict(schema='PRNG_T021_CERTIFICATE_V1',status=STATUS,task_id='FT1536_PRNG_LAYOUT_COUNTER_RUN_001',
        road_map_id='T02.1',author='Niirmata (project author)',
        source_attribution='Falcon Project / Thomas Pornin; original licenses preserved',
        base_commit=BASE,task_sha256=TASK_SHA,sagemath_rule_sha256=RULE_SHA,
        bootstrap_manifest_sha256=MANIFEST_SHA,
        contract_A=dict(proved=True,subject='56-byte init layout, type dispatch, call order, frame',
            evidence=['model/prng_model.sage layout section',
                      'model/prng_checker.sage layout.*, fixture.*.type_returned, unsupported.*, frame controls',
                      'SOURCE_MODEL_BINDING.md A']),
        contract_B=dict(proved=True,subject='exact 64-block refill, counter lanes, feed-forward, LE serialization, post counter/frame',
            evidence=['model/prng_model.sage falcon_block/falcon_refill',
                      'model/prng_checker.sage byte binding and counter formulas',
                      'KAT core cross-check vs OpenSSL and RFC 8439 section 2.3.2',
                      'SOURCE_MODEL_BINDING.md B']),
        contract_C=dict(proved=True,subject='T01 budget consumer and q-refill corollary',
            evidence=['model/prng_model.sage ZZ resource consumer',
                      'model/prng_checker.sage resources.* rederivation',
                      'RESOURCE_INTERFACE.json']),
        counter=dict(per_block='cc0+k mod 2^64 for 0<=k<64 per refill',
            post_refill='cc0+64 mod 2^64',first_48_bytes_preserved=True,ptr_after_refill=0,
            distinct_within_context=True,wrap_not_repeat=True,
            wrap_fixtures=['F4_IV_ASYM_CTR64M1','F5_IV_ASYM_CTR64M64','F6_IV_ASYM_CTR64M65'],
            cross_context_reuse_possible=True),
        mutations=dict(killed=killed,no_op_by_construction=noops,detail='artifacts/mutations.json'),
        kat=dict(vectors=kat['count'],oracle=kat['openssl'],rfc8439_2_3_2=True,classic_all_zero=True),
        proof_files=proof_files,
        flags=dict(real_prng_to_iid_bridge_proved=False,SHAKE_security_proved=False,
            ChaCha_security_proved=False,whole_real_Sign_proved=False,source_changed=False,
            production_source_changed=False,owner_accepted=False,T02_parent_open=True),
        scope='A+B+C of T02.1 for the pinned source model only; fixture equality is binding '
              'evidence, the universal-legal-input argument lives in SOURCE_MODEL_BINDING.md; '
              'Lean not used (optional in TASK section 6)')
    (W/'PRNG_LAYOUT_CERTIFICATE.json').write_text(json.dumps(cert,indent=2)+'\n')
    cert_sha=sha(W/'PRNG_LAYOUT_CERTIFICATE.json')
    result=dict(schema='FT1536_T02_1_RESULT_V1',task_id='FT1536_PRNG_LAYOUT_COUNTER_RUN_001',
        road_map_id='T02.1',status=STATUS,author='Niirmata (project author)',base_commit=BASE,
        task_sha256=TASK_SHA,sagemath_rule_sha256=RULE_SHA,bootstrap_manifest_sha256=MANIFEST_SHA,
        contract_A_proved=True,contract_B_proved=True,contract_C_proved=True,
        layout_certified=True,block_spec_proved=True,counter_frame_proved=True,
        resource_consumer_proved=True,mutation_battery_passed=True,kat_core_cross_checked=True,
        real_prng_to_iid_bridge_proved=False,SHAKE_security_proved=False,ChaCha_security_proved=False,
        whole_real_Sign_proved=False,source_changed=False,production_source_changed=False,
        owner_accepted=False,T02_parent_open=True,
        fixture_scope='7 public synthetic 56-byte fixtures x 3 stages: binding evidence, not the universal argument',
        universal_source_binding='SOURCE_MODEL_BINDING.md',
        counts=dict(fixtures=7,stages=21,checker_checks=checker['checks'],
            compared_fields=checker['field_pairs_compared'],mutations=len(muts['mutations']),
            kat_vectors=kat['count']),
        resource_numbers=dict(r_max=res['r_max'],blocks_per_reached_context=res['blocks_per_reached_context'],
            region_block_evaluations=res['region_block_evaluations'],
            requested_parent_SHAKE56_bytes=res['requested_parent_SHAKE56_bytes'],
            with_nonce40_upper=res['with_nonce40_upper']),
        certificate_sha256=cert_sha,replay_required=True,replay_receipt='artifacts/fresh_replay.json',
        report='REPORT.md',claim='CLAIM.md',proof_files=proof_files)
    (W/'RESULT.json').write_text(json.dumps(result,indent=2)+'\n')
    toolchain='\n'.join([
        'T02.1 toolchain (pinned host, no network use)',
        'cc: '+first_line(['c99','--version'])+'   [driver: c99, flags: -W -Wall -O]',
        'sage: '+first_line(['/home/footfalcon/.local/bin/sage','--version'])+'   [entry: sage <file>.sage]',
        'openssl: '+kat['openssl'],
        'arch: '+platform.machine()+' / '+platform.system()+' / LP64 little-endian (FALCON_LE_U=1)',
        'python3: '+platform.python_version()+' (organization/hashing/logging only)',
        'sanitizer: gcc -fsanitize=address,undefined -fno-sanitize-recover=all (separate run)',
        'lean: not used (optional in TASK section 6)',''])
    (W/'TOOLCHAIN.txt').write_text(toolchain)
    inputs=[]
    for pat in ('inputs/bootstrap','inputs/documents','source'):
        inputs += sorted((W/pat).rglob('*'))
    inputs += [W/'TASK.md',W/'SAGEMATH_RULE.md']
    lines=[sha(p)+'  '+str(p)+'\n' for p in inputs if p.is_file() and not p.is_symlink()]
    (W/'INPUTS.sha256').write_text(''.join(lines))
    print('claims written: LAYOUT.json RESOURCE_INTERFACE.json PRNG_LAYOUT_CERTIFICATE.json '
          'RESULT.json TOOLCHAIN.txt INPUTS.sha256 (%d input records)'%len(lines))
if __name__=='__main__':main()
