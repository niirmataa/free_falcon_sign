"\t\tb[11] ^= b[35] ^ b[47];\n",
"\t\tb[12] ^= b[24];\n",
"\t\tb[13] ^= b[25];\n",
"\t\tb[14] ^= b[26];\n",
"\t\tb[15] ^= b[27];\n",
"\t\tb[16] ^= b[28];\n",
"\t\tb[17] ^= b[29];\n",
"\t\tb[18] ^= b[30];\n",
"\t\tb[19] ^= b[31];\n",
"\t\tb[20] ^= b[32];\n",
"\t\tb[21] ^= b[33];\n",
"\t\tb[22] ^= b[34];\n",
"\t\tb[23] ^= b[35];\n",
"\t\t/* fall through */\n",
"\n",
"\tcase 9:\n",
"\t\t/*\n",
"\t\t * a0 = b[0..5]\n",
"\t\t * a1 = b[6..11]\n",
"\t\t * a2 = b[12..17]\n",
"\t\t * a3 = b[18..23]\n",
"\t\t */\n",
"\t\tb[0] ^= b[12] ^ b[18];\n",
"\t\tb[1] ^= b[13] ^ b[19];\n",
"\t\tb[2] ^= b[14] ^ b[20];\n",
"\t\tb[3] ^= b[15] ^ b[21];\n",
"\t\tb[4] ^= b[16] ^ b[22];\n",
"\t\tb[5] ^= b[17] ^ b[23];\n",
"\t\tb[6] ^= b[12];\n",
"\t\tb[7] ^= b[13];\n",
"\t\tb[8] ^= b[14];\n",
"\t\tb[9] ^= b[15];\n",
"\t\tb[10] ^= b[16];\n",
"\t\tb[11] ^= b[17];\n",
"\t\t/* fall through */\n",
"\tcase 8:\n",
"\t\t/*\n",
"\t\t * a0 = b[0..2]\n",
"\t\t * a1 = b[3..5]\n",
"\t\t * a2 = b[6..8]\n",
"\t\t * a3 = b[9..11]\n",
"\t\t */\n",
"\t\tb[0] ^= b[6] ^ b[9];\n",
"\t\tb[1] ^= b[7] ^ b[10];\n",
"\t\tb[2] ^= b[8] ^ b[11];\n",
"\t\tb[3] ^= b[6];\n",
"\t\tb[4] ^= b[7];\n",
"\t\tb[5] ^= b[8];\n",
"\t\t/* fall through */\n",
"\tcase 7:\n",
"\t\t/*\n",
"\t\t * a0 = b[0] || b[1](0..15)\n",
"\t\t * a1 = b[1](16..31) || b[2]\n",
"\t\t * a2 = b[3] || b[4](0..15)\n",
"\t\t * a3 = b[4](16..31) || b[5]\n",
"\t\t */\n",
"\t\tb[0] ^= b[3] ^ (b[4] >> 16) ^ (b[5] << 16);\n",
"\t\tb[1] ^= (b[4] & 0xFFFF) ^ (b[5] >> 16);\n",
"\t\tb[1] ^= (b[3] << 16);\n",
"\t\tb[2] ^= (b[3] >> 16) ^ (b[4] << 16);\n",
"\t\t/* fall through */\n",
"\tcase 6:\n",
"\t\t/*\n",
"\t\t * a0 = b[0](0..23)\n",
"\t\t * a1 = b[0](24..31) || b[1](0..15)\n",
"\t\t * a2 = b[1](16..31) || b[2](0..7)\n",
"\t\t * a3 = b[2](8..31)\n",
"\t\t */\n",
"\t\tb[0] ^= (b[1] >> 16) ^ ((b[2] & 0xFF) << 16) ^ (b[2] >> 8);\n",
"\t\tb[0] ^= ((b[1] << 8) & 0xFF000000);\n",
"\t\tb[1] ^= (b[1] >> 24) ^ ((b[2] & 0xFF) << 8);\n",
"\t\tb[1] &= 0xFFFF;\n",
"\t\t/* fall through */\n",
"\tcase 5:\n",
"\t\t/*\n",
"\t\t * a0 = b[0](0..11)\n",
"\t\t * a1 = b[0](12..23)\n",
"\t\t * a2 = b[0](24..31) || b[1](0..3)\n",
"\t\t * a3 = b[1](4..15)\n",
"\t\t */\n",
"\t\tb[0] ^= (b[0] >> 24) ^ ((b[1] & 0x0F) << 8) ^ (b[1] >> 4);\n",
"\t\tb[0] ^= ((b[0] >> 12) & 0xFF000) ^ ((b[1] & 0x0F) << 20);\n",
"\t\tb[0] &= 0xFFFFFF;\n",
"\t\t/* fall through */\n",
"\tcase 4:\n",
"\t\t/*\n",
"\t\t * a0 = b[0](0..5)\n",
"\t\t * a1 = b[0](6..11)\n",
"\t\t * a2 = b[0](12..17)\n",
"\t\t * a3 = b[0](18..23)\n",
"\t\t */\n",
"\t\tb[0] ^= ((b[0] >> 12) & 0x3F) ^ ((b[0] >> 18) & 0x3F);\n",
"\t\tb[0] ^= ((b[0] >> 6) & 0xFC0);\n",
"\t\tb[0] &= 0xFFF;\n",
"\t\t/* fall through */\n",
"\tcase 3:\n",
"\t\t/*\n",
"\t\t * a0 = b[0](0..2)\n",
"\t\t * a1 = b[0](3..5)\n",
"\t\t * a2 = b[0](6..8)\n",
"\t\t * a3 = b[0](9..11)\n",
"\t\t */\n",
"\t\tb[0] ^= ((b[0] >> 6) & 0x7) ^ ((b[0] >> 9) & 0x7);\n",
"\t\tb[0] ^= ((b[0] >> 3) & 0x38);\n",
