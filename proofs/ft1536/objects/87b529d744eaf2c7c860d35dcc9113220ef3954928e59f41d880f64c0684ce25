"\t\t\t\tlogn, ter))\n",
"\t\t\t{\n",
"#ifdef FG_DISTRIBUTION_PROBE\n",
"\t\t\t\tfg_probe_stats.reject_leaf_cert ++;\n",
"\t\t\t\tfg_probe_record_attempt(f, g, n,\n",
"\t\t\t\t\tFG_PROBE_REJECT_LEAF_CERT,\n",
"\t\t\t\t\tprobe_raw_norm, probe_gs_norm, probe_bound);\n",
"#endif\n",
"\t\t\t\tcontinue;\n",
"\t\t\t}\n",
"\t\t}\n",
"\n",
"#ifdef FG_DISTRIBUTION_PROBE\n",
"\t\tif (ter) {\n",
"\t\t\tfg_probe_record_attempt(f, g, n, FG_PROBE_SUCCESS,\n",
"\t\t\t\tprobe_raw_norm, probe_gs_norm, probe_bound);\n",
"\t\t\tfg_probe_record_keygen_complete(local_attempts);\n",
"\t\t}\n",
"#endif\n",
"\n",
"\t\t/*\n",
"\t\t * Key pair is generated.\n",
"\t\t */\n",
"\t\tbreak;\n",
"\t}\n",
"\n",
"\t/*\n",
"\t * Encode private key.\n",
"\t */\n",
"\tklen = *privkey_len;\n",
"\tskbuf = privkey;\n",
"\tif (klen < 1) {\n",
"\t\treturn 0;\n",
"\t}\n",
"\tskbuf[0] = (ter << 7) + (comp << 5) + logn;\n",
"\tskoff = 1;\n",
"\tske[0] = f;\n",
"\tske[1] = g;\n",
"\tske[2] = F;\n",
"\tske[3] = G;\n",
"\tfor (i = 0; i < 4; i ++) {\n",
"\t\tsize_t elen;\n",
"\n",
"\t\telen = falcon_encode_small(skbuf + skoff, klen - skoff,\n",
"\t\t\tcomp, ter ? 18433 : 12289, ske[i], logn);\n",
"\t\tif (elen == 0) {\n",
"\t\t\treturn 0;\n",
"\t\t}\n",
"\t\tskoff += elen;\n",
"\t}\n",
"\t*privkey_len = skoff;\n",
"\n",
"\t/*\n",
"\t * Encode public key.\n",
"\t */\n",
"\tklen = *pubkey_len;\n",
"\tif (klen < 1) {\n",
"\t\treturn 0;\n",
"\t}\n",
"\t((unsigned char *)pubkey)[0] = (ter << 7) + logn;\n",
"\tif (ter) {\n",
"\t\tklen = falcon_encode_18433(\n",
"\t\t\t(unsigned char *)pubkey + 1, klen - 1, h, logn);\n",
"\t} else {\n",
"\t\tklen = falcon_encode_12289(\n",
"\t\t\t(unsigned char *)pubkey + 1, klen - 1, h, logn);\n",
"\t}\n",
"\tif (klen == 0) {\n",
"\t\treturn 0;\n",
"\t}\n",
"\t*pubkey_len = klen + 1;\n",
"\n",
"\t/*\n",
"\t * Success!\n",
"\t */\n",
"\treturn 1;\n",
"}\n"
]
