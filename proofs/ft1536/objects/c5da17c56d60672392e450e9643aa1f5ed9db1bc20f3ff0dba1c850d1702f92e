--- B20.C.cond_neg_add64 [theorem]  (B20/C/SignedArith.lean)
∀ (a s : BitVec 64),
  s.toNat ≤ 1 →
    a.toNat < 2 ^ 63 - 1 →
      B20.C.signedBitsOp B20.C.BinOp.xor a (-s) = B20.C.bitsOp B20.C.BinOp.xor a (-s) ∧
        ∃ r,
          B20.C.signedBitsOp B20.C.BinOp.add (a ^^^ -s) s = B20.C.bitsOp B20.C.BinOp.add (a ^^^ -s) s ∧
            r = (a ^^^ -s) + s ∧ r.toInt = if s.toNat = 0 then a.toInt else -a.toInt
axioms: [propext, Classical.choice, Quot.sound]

--- B20.C.cond_neg_add64_le [theorem]  (B20/C/SignedArith.lean)
∀ (a s : BitVec 64),
  s.toNat ≤ 1 →
    a.toNat ≤ 2 ^ 63 - 1 →
      B20.C.signedBitsOp B20.C.BinOp.xor a (-s) = B20.C.bitsOp B20.C.BinOp.xor a (-s) ∧
        ∃ r,
          B20.C.signedBitsOp B20.C.BinOp.add (a ^^^ -s) s = B20.C.bitsOp B20.C.BinOp.add (a ^^^ -s) s ∧
            r = (a ^^^ -s) + s ∧ r.toInt = if s.toNat = 0 then a.toInt else -a.toInt
axioms: [propext, Classical.choice, Quot.sound]

