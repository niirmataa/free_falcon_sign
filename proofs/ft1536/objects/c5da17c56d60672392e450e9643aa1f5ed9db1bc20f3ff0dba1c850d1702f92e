--- B20.Fpr.pack_add_bits [theorem]  (B20/Fpr/Spec.lean)
∀ (e : BitVec 32),
  -2 ^ 31 ≤ e.toInt + 1076 ∧ e.toInt + 1076 < 2 ^ 31 →
    B20.C.signedBitsOp B20.C.BinOp.add e 1076#32 = B20.C.bitsOp B20.C.BinOp.add e 1076#32
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.pack_add_safe [theorem]  (B20/Fpr/Spec.lean)
∀ (e : BitVec 32),
  -2 ^ 31 ≤ e.toInt + 1076 ∧ e.toInt + 1076 < 2 ^ 31 → B20.C.signedSafe B20.C.BinOp.add e 1076#32 = true
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.pack_and7_lt [theorem]  (B20/Fpr/Spec.lean)
∀ (n : ℕ), n &&& 7 < 32
axioms: [propext, Quot.sound]

--- B20.Fpr.pack_execution [theorem]  (B20/Fpr/Spec.lean)
∀ (s e : BitVec 32) (m : BitVec 64),
  B20.Fpr.packDomain s e →
    B20.C.Scalar.execute B20.C.Scalar.shiftCalls B20.Fpr.Parsed.packProgram
        [B20.C.Val.i32 s, B20.C.Val.i32 e, B20.C.Val.u64 m] =
      some (B20.C.Val.u64 (B20.Fpr.packSpec s e m))
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.pack_f_range [theorem]  (B20/Fpr/Spec.lean)
∀ (x : BitVec 64), (BitVec.setWidth 32 x &&& 7#32).toNat < 32
axioms: [propext, Quot.sound]

--- B20.Fpr.pack_neg_defined [theorem]  (B20/Fpr/Spec.lean)
∀ (m : BitVec 64),
  B20.C.neg (B20.C.Val.i32 (BitVec.setWidth 32 (m >>> 54))) = some (B20.C.Val.i32 (-BitVec.setWidth 32 (m >>> 54)))
axioms: [propext, Quot.sound]

--- B20.Fpr.pack_t_range [theorem]  (B20/Fpr/Spec.lean)
∀ (m : BitVec 64), (BitVec.setWidth 32 (m >>> 54)).toNat < 2 ^ 31
axioms: [propext, Quot.sound]

--- B20.Fpr.parsedCallSites [def]  (B20/Fpr/Domain.lean)
List (B20.C.Name × B20.C.Name)

--- B20.Fpr.rintDomain [def]  (B20/Fpr/Spec.lean)
BitVec 64 → Prop

--- B20.Fpr.rintSpec [def]  (B20/Fpr/Spec.lean)
BitVec 64 → BitVec 64

--- B20.Fpr.rint_d [def]  (B20/Fpr/Spec.lean)
BitVec 64 → BitVec 64

--- B20.Fpr.rint_dd [def]  (B20/Fpr/Spec.lean)
BitVec 64 → BitVec 32

--- B20.Fpr.rint_e [def]  (B20/Fpr/Spec.lean)
BitVec 64 → BitVec 32

--- B20.Fpr.rint_e2 [def]  (B20/Fpr/Spec.lean)
BitVec 64 → BitVec 32

--- B20.Fpr.rint_e2_range [theorem]  (B20/Fpr/Spec.lean)
∀ (e : BitVec 32), (e &&& 63#32).toNat < 64 ∧ 0 ≤ (e &&& 63#32).toInt ∧ (e &&& 63#32).toInt ≤ 63
axioms: [propext, Quot.sound]

--- B20.Fpr.rint_e_int [theorem]  (B20/Fpr/Spec.lean)
∀ (x : BitVec 64),
  (1085#32 - (BitVec.setWidth 32 (x >>> 52) &&& 2047#32)).toInt =
      ↑1085 - (BitVec.setWidth 32 (x >>> 52) &&& 2047#32).toInt ∧
    -↑962 ≤ (1085#32 - (BitVec.setWidth 32 (x >>> 52) &&& 2047#32)).toInt ∧
      (1085#32 - (BitVec.setWidth 32 (x >>> 52) &&& 2047#32)).toInt ≤ 1085
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.rint_e_nat [theorem]  (B20/Fpr/Spec.lean)
∀ (x : BitVec 64),
  B20.Fpr.rintDomain x →
    ↑(1085#32 - (BitVec.setWidth 32 (x >>> 52) &&& 2047#32)).toNat =
        (1085#32 - (BitVec.setWidth 32 (x >>> 52) &&& 2047#32)).toInt ∧
      13 ≤ (1085#32 - (BitVec.setWidth 32 (x >>> 52) &&& 2047#32)).toNat ∧
        (1085#32 - (BitVec.setWidth 32 (x >>> 52) &&& 2047#32)).toNat ≤ 1085
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.rint_execution [theorem]  (B20/Fpr/RintExec.lean)
∀ (x : BitVec 64),
  B20.Fpr.rintDomain x →
    B20.C.Scalar.execute B20.C.Scalar.shiftCalls B20.Fpr.Parsed.rintProgram [B20.C.Val.u64 x] =
      some (B20.C.Val.i64 (B20.Fpr.rintSpec x))
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.rint_f [def]  (B20/Fpr/Spec.lean)
BitVec 64 → BitVec 32

--- B20.Fpr.rint_f_range [theorem]  (B20/Fpr/Spec.lean)
∀ (d : BitVec 64) (dd : BitVec 32),
  (BitVec.setWidth 32 (d >>> 61) ||| (dd ||| -dd) >>> 31).toNat < 32
axioms: [propext, Quot.sound]

--- B20.Fpr.rint_m0 [def]  (B20/Fpr/Spec.lean)
BitVec 64 → BitVec 64

--- B20.Fpr.rint_m1 [def]  (B20/Fpr/Spec.lean)
BitVec 64 → BitVec 64

--- B20.Fpr.rint_m2 [def]  (B20/Fpr/Spec.lean)
BitVec 64 → BitVec 64

--- B20.Fpr.rint_m2_big [theorem]  (B20/Fpr/Spec.lean)
∀ (x : BitVec 64),
  B20.Fpr.rintDomain x → ¬(B20.Fpr.rint_e x).toNat < 64 → (B20.Fpr.rint_m2 x).toNat < 2 ^ 63 - 1
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.rint_m2_small [theorem]  (B20/Fpr/Spec.lean)
∀ (x : BitVec 64),
  B20.Fpr.rintDomain x → (B20.Fpr.rint_e x).toNat < 64 → (B20.Fpr.rint_m2 x).toNat < 2 ^ 63 - 1
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.rint_mask [def]  (B20/Fpr/Spec.lean)
BitVec 32 → BitVec 64

--- B20.Fpr.rint_mask_all [theorem]  (B20/Fpr/Spec.lean)
∀ (e : BitVec 32), e.toNat < 64 → B20.Fpr.rint_mask e = BitVec.allOnes 64
axioms: [propext, Quot.sound]

--- B20.Fpr.rint_mask_zero [theorem]  (B20/Fpr/Spec.lean)
∀ (e : BitVec 32), 64 ≤ e.toNat ∧ e.toNat < 2 ^ 31 → B20.Fpr.rint_mask e = 0#64
axioms: [propext, Quot.sound]

--- B20.Fpr.rint_s [def]  (B20/Fpr/Spec.lean)
BitVec 64 → BitVec 32

--- B20.Fpr.rint_s_range [theorem]  (B20/Fpr/Spec.lean)
∀ (x : BitVec 64), (BitVec.setWidth 32 (x >>> 63)).toNat ≤ 1
axioms: [propext, Quot.sound]

--- B20.Fpr.rint_sub63_count [theorem]  (B20/Fpr/Spec.lean)
∀ (e2 : BitVec 32), 0 ≤ e2.toInt ∧ e2.toInt ≤ 63 → (63#32 - e2).toNat < 64
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.rint_sub63_safe [theorem]  (B20/Fpr/Spec.lean)
∀ (e2 : BitVec 32),
  0 ≤ e2.toInt ∧ e2.toInt ≤ 63 →
    B20.C.signedBitsOp B20.C.BinOp.sub (63#32) e2 = B20.C.bitsOp B20.C.BinOp.sub (63#32) e2 ∧
      (63#32 - e2).toInt = 63 - e2.toInt
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.rint_ulsh_domain [theorem]  (B20/Fpr/Domain.lean)
∀ (x : BitVec 64),
  0 ≤ (B20.Fpr.rint_e2 x).toInt ∧ (B20.Fpr.rint_e2 x).toInt ≤ 63 →
    B20.Fpr.UlshDomain (B20.Fpr.rint_m1 x) (63#32 - B20.Fpr.rint_e2 x)
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.rint_ursh_domain [theorem]  (B20/Fpr/Domain.lean)
∀ (x : BitVec 64), B20.Fpr.UrshDomain (B20.Fpr.rint_m1 x) (B20.Fpr.rint_e2 x)
axioms: [propext, Quot.sound]

--- B20.Fpr.rint_y [def]  (B20/Fpr/Spec.lean)
BitVec 64 → BitVec 32

--- B20.Fpr.rint_y_int [theorem]  (B20/Fpr/Spec.lean)
∀ (x : BitVec 64),
  ↑0 ≤ (BitVec.setWidth 32 (x >>> 52) &&& 2047#32).toInt ∧ (BitVec.setWidth 32 (x >>> 52) &&& 2047#32).toInt ≤ 2047
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.rint_y_range [theorem]  (B20/Fpr/Spec.lean)
∀ (x : BitVec 64), (BitVec.setWidth 32 (x >>> 52) &&& 2047#32).toNat < 2048
axioms: [propext, Quot.sound]

--- B20.Fpr.signedBits_band32 [theorem]  (B20/Fpr/Spec.lean)
∀ (x y : BitVec 32),
  B20.C.signedBitsOp B20.C.BinOp.band x y = B20.C.bitsOp B20.C.BinOp.band x y
axioms: [propext, Quot.sound]

--- B20.Fpr.signedBits_band64 [theorem]  (B20/Fpr/Spec.lean)
∀ (x y : BitVec 64),
  B20.C.signedBitsOp B20.C.BinOp.band x y = B20.C.bitsOp B20.C.BinOp.band x y
axioms: [propext, Quot.sound]

--- B20.Fpr.signedBits_xor64 [theorem]  (B20/Fpr/Spec.lean)
∀ (x y : BitVec 64),
  B20.C.signedBitsOp B20.C.BinOp.xor x y = B20.C.bitsOp B20.C.BinOp.xor x y
axioms: [propext, Quot.sound]

--- B20.Fpr.sub_execution [theorem]  (B20/Fpr/Spec.lean)
∀ (calls : B20.C.Scalar.Calls) (x y w : BitVec 64),
  calls "fpr_add".toList [B20.C.Val.u64 x, B20.C.Val.u64 (y ^^^ 1 <<< 63)] = some (B20.C.Val.u64 w) →
    B20.C.Scalar.execute calls B20.Fpr.Parsed.subProgram [B20.C.Val.u64 x, B20.C.Val.u64 y] = some (B20.C.Val.u64 w)
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.sub_refines_via_add_obligation [theorem]  (B20/Fpr/Domain.lean)
∀ (x y w : BitVec 64),
  B20.Fpr.AddCallObligation x (y ^^^ 1 <<< 63) w →
    B20.C.Scalar.execute B20.C.Scalar.shiftCalls B20.Fpr.Parsed.subProgram [B20.C.Val.u64 x, B20.C.Val.u64 y] =
      some (B20.C.Val.u64 w)
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.ulsh_call_of_toNat [theorem]  (B20/Fpr/Spec.lean)
∀ (m1 : BitVec 64) (c : BitVec 32),
  c.toNat < 64 →
    B20.C.Scalar.shiftCalls "fpr_ulsh".toList [B20.C.Val.u64 m1, B20.C.Val.i32 c] =
      some (B20.C.Val.u64 (m1 <<< c.toNat))
axioms: [propext, Classical.choice, Quot.sound]

--- B20.Fpr.ursh_call_of_toNat [theorem]  (B20/Fpr/Spec.lean)
∀ (m1 : BitVec 64) (c : BitVec 32),
  c.toNat < 64 →
    B20.C.Scalar.shiftCalls "fpr_ursh".toList [B20.C.Val.u64 m1, B20.C.Val.i32 c] =
      some (B20.C.Val.u64 (m1 >>> c.toNat))
axioms: [propext, Classical.choice, Quot.sound]

