\subsection{R4: the exact FT1536 multi-target inhomogeneous-SIS assumption}

Put
\[
 R=\mathbb Z[x]/(\Phi),\qquad
 R_q=R/qR,\qquad
 \Phi=x^{1536}-x^{768}+1,\qquad q=18433,
\]
and write $n=1536$, $N=2n=3072$, $B=2093922385$.  For
$a=(a_0,\ldots,a_{1535})\in R$, define
\[
 Q_R(a)=\sum_{k=0}^{767}
 \bigl(a_k^2+a_ka_{k+768}+a_{k+768}^2\bigr),
 \qquad Q(z_1,z_2)=Q_R(z_1)+Q_R(z_2).
\]
Thus $Q$ is exactly the direct sum of $1536$ copies of
$A_2=\bigl(\begin{smallmatrix}1&1/2\\1/2&1\end{smallmatrix}\bigr)$.
Let
\[
 \mathcal C_q=\{-9216,-9215,\ldots,9216\}^{1536}\subset R
\]
denote the coefficientwise centered representatives.

\begin{definition}[Accepted FT1536 public-key law]\label{def:R4-key-law}
Let $\mathcal K_{\rm acc}$ be the distribution obtained by drawing an
infinite-tape KeyGen attempt from the product coefficient-ternary law,
conditioning on every deterministic acceptance predicate of REV5
Algorithm~1, and publishing
\[
 h=g f^{-1}\pmod{(q,\Phi)}.
\]
This is the public-key push-forward of the accepted KeyGen law of REV5
\S17.1; it is not the uniform law on $R_q$.  Independent successful calls
mean independent draws from $\mathcal K_{\rm acc}$.  The deployed
256-bit-seed/SHAKE push-forward is not silently substituted for this law.
\end{definition}

\begin{definition}[The game
$\mathsf{MT\mbox{-}ISIS}_{\rm FT1536}(U,T,B)$]\label{def:R4-game}
Let $U,T\ge1$.  The challenger samples
\[
 h_1,\ldots,h_U\ \xleftarrow{\$}\ \mathcal K_{\rm acc}
\]
independently and, independently of the keys, samples
\[
 c_{i,j}\ \xleftarrow{\$}\ R_q
 \quad(1\le i\le U,\ 1\le j\le T)
\]
independently and uniformly.  It gives the indexed arrays
$((h_i)_{i=1}^U,(c_{i,j})_{i,j})$ to the adversary.  The adversary returns
one tuple $(i,j,z_1,z_2)$.  It wins exactly when
\begin{equation}\label{eq:R4-language}
 \begin{gathered}
 i\in[U],\quad j\in[T],\quad z_1,z_2\in R,\quad z_2\in\mathcal C_q,\\
 z_1+h_i z_2\equiv c_{i,j}\pmod{(q,\Phi)},\qquad
 Q(z_1,z_2)<B .
 \end{gathered}
\end{equation}
Because $Q$ is integral, the last condition is equivalently
$Q(z_1,z_2)\leq B-1$; it is never relaxed to $Q\leq B$.
Sampling is with replacement: zero targets and key or target collisions are
allowed, and the indices remain part of the public instance.  The target list
is static.  Adaptive random-oracle targets, programming, prequeries and $Q_H$
losses belong to R5.
\end{definition}

Definition~\ref{def:R4-game} is deliberately a relation-language game: it
does not require $z_1$ to be the canonical representative of its congruence
class.  Its verifier-exact sublanguage additionally imposes
\[
 z_1=\operatorname{center}_q(c_{i,j}-h_i z_2).
\]
Let $\varepsilon_{\rm VerExact}(U,T;\mathscr C)$ denote the supremum of the
winning probability in this subgame over the same resource class
$\mathscr C$.  Thus every verifier-exact win is a relation-language win and
\begin{equation}\label{eq:R4-verifier-subset}
 \varepsilon_{\rm VerExact}(U,T;\mathscr C)
 \leq\varepsilon_{\rm MT}(U,T;\mathscr C).
\end{equation}

For an adversary $\mathcal A$, denote its winning probability in
Definition~\ref{def:R4-game} by
$\operatorname{Adv}^{\rm mtisis}_{\rm FT1536}(\mathcal A;U,T)$.

The raw winning probability has an unavoidable, explicitly retained floor.
Since $|R_q|=q^n$ and zero is among the uniform targets, an adversary that
returns the witness $z_1=z_2=0$ at the first zero target's index wins with
probability, in every resource class containing this linear scan,
\begin{equation}\label{eq:R4-zero-floor}
 1-(1-q^{-n})^{UT}\leq UTq^{-n}.
\end{equation}
Any concrete upper bound on $\varepsilon_{\rm MT}$ must therefore include
this event; the assumption does not exclude zero targets.

\begin{assumption}[Concrete FT1536 MT-ISIS assumption]\label{ass:R4-mtisis}
For every stated adversary resource class $\mathscr C$, the quantity
\[
 \varepsilon_{\rm MT}(U,T;\mathscr C)
 =\sup_{\mathcal A\in\mathscr C}
   \operatorname{Adv}^{\rm mtisis}_{\rm FT1536}(\mathcal A;U,T)
\]
is assumed small enough for the downstream concrete reduction.  This is a
hardness assumption, not a theorem proved in this paper.  If FT1536 is placed
inside an explicitly specified asymptotic family and $U,T$ are polynomially
bounded, the corresponding family-level assumption is that this advantage is
negligible.  For the fixed parameter instance, downstream bounds retain the
concrete symbol $\varepsilon_{\rm MT}$ rather than using an unquantified
asymptotic adjective.
\end{assumption}

\noindent Write $\mathsf{ST\mbox{-}ISIS}_{\rm FT1536}$ for the $U=T=1$
specialization of Definition~\ref{def:R4-game}, and define
$\operatorname{Adv}^{\rm stisis}_{\rm FT1536}(\mathcal B)
=\operatorname{Adv}^{\rm mtisis}_{\rm FT1536}(\mathcal B;1,1)$.

\begin{lemma}[Exact $U\!\cdot\!T$ target-guessing reduction]
\label{lem:R4-UT}
Assume access to exact independent samplers for $\mathcal K_{\rm acc}$ and
the uniform law on $R_q$.
Let $\mathcal A$ win
$\mathsf{MT\mbox{-}ISIS}_{\rm FT1536}(U,T,B)$ with probability
$\varepsilon$.  There is a single-key, single-target adversary $\mathcal B$
with an exact challenge from the same laws such that
\[
 \operatorname{Adv}^{\rm stisis}_{\rm FT1536}(\mathcal B)
 =\frac{\varepsilon}{UT}.
\]
Consequently, after accounting for the cost of sampling $U-1$ additional
accepted keys and $UT-1$ additional targets,
\begin{equation}\label{eq:R4-UT}
 \operatorname{Adv}^{\rm mtisis}_{\rm FT1536}(\mathcal A;U,T)
 \le UT\,
 \sup_{\mathcal B\in\mathscr C'}
 \operatorname{Adv}^{\rm stisis}_{\rm FT1536}(\mathcal B).
\end{equation}
\end{lemma}

\begin{proof}
$\mathcal B$ receives $(h^\star,c^\star)$ with
$h^\star\leftarrow\mathcal K_{\rm acc}$ and
$c^\star\leftarrow R_q$ uniform.  It chooses
$(I,J)\leftarrow[U]\times[T]$ uniformly, installs
$(h_I,c_{I,J})=(h^\star,c^\star)$, and samples every other key and target
from its prescribed independent law.  The simulated indexed array has
exactly the game distribution, for every value of $(I,J)$.  If
$\mathcal A$ returns a winning tuple at $(I,J)$, $\mathcal B$ returns
$(1,1,z_1,z_2)$; otherwise it fails.  Writing $\varepsilon_{i,j}$ for the probability
that $\mathcal A$ wins and returns index $(i,j)$,
\[
 \Pr[\mathcal B\text{ wins}]
 =\frac1{UT}\sum_{i=1}^U\sum_{j=1}^T\varepsilon_{i,j}
 =\frac{\varepsilon}{UT}.
\]
No uniform-public-key replacement or adaptive-target hybrid is used.
\end{proof}

If $\mathcal K_{\rm acc}$ is exposed as a game sampler, the construction has
no key-conditioning advantage loss.  If it is instead implemented by
rejection sampling raw KeyGen tapes with success probability $p_{\rm acc}$,
the additional $U-1$ accepted keys cost $(U-1)/p_{\rm acc}$ raw attempts in
expectation.  A strict worst-case-time reduction must either assume the
accepted-key sampler or cap retries and add the resulting simulator-abort
probability.  No second $UT$ union-bound factor is applied after
Lemma~\ref{lem:R4-UT}.

\begin{lemma}[Mathematical trapdoor algebra and accepting-verifier witness]
\label{lem:R4-witness}
Let a successful secret basis satisfy
\[
 fG-gF=q,\qquad h=g f^{-1}\pmod{(q,\Phi)},\qquad
 \mathbf B=\begin{pmatrix}g&-f\\G&-F\end{pmatrix}.
\]
Then both rows of $\mathbf B$ are in
$\ker A_h$, where $A_h(a,b)=a+hb$.  For target $(c,0)$,
choose a lift $c\in R$, put $R_{\mathbb Q}=R\otimes_{\mathbb Z}\mathbb Q$,
and form the rational trapdoor coordinates
\[
 \tau=(c,0)\mathbf B^{-1}\in R_{\mathbb Q}^2,
 \qquad
 \tau
 =q^{-1}(-cF,cf).
\]
If the recursive sampler returns the residual $e=\tau-y$ with
$y\in R^2$, then the signer's mathematical output
$z=e\mathbf B=(c,0)-y\mathbf B$ satisfies
\[
 z_1+h z_2\equiv c\pmod{(q,\Phi)}.
\]
Whenever the strict signer test $Q(z)<B$ and the separate centered-output
interface for $z_2$ hold, this is a relation-language witness for the public
instance $(h,c)$.  If that instance is a challenged pair $(h_i,c_{i,j})$, the
indexed tuple wins Definition~\ref{def:R4-game}.  This first implication is
solely the pre-serialization mathematical residual identity of the stated
signing model, conditional on both displayed interface tests; it makes no
claim about every byte-level source path.

Conversely, suppose the public verifier accepts a decoded signature.  Let
$c=\mathsf{HashToPoint}(r,m)$, let the decoded polynomial be
$z_2\in\mathcal C_q$, and put
\[
 y_1=\operatorname{center}_q(hz_2-c),\qquad z_1=-y_1.
\]
Then $z_1+hz_2\equiv c\pmod{(q,\Phi)}$ and
$Q(z_1,z_2)=Q(y_1,z_2)<B$.  Thus every accepting verifier transcript maps
deterministically to a verifier-exact witness for its public instance
$(h,c)$.  If $h=h_i$ and $c=c_{i,j}$ for a challenged indexed pair, then
$(i,j,z_1,z_2)$ is a winning R4 output.  Relating hash queries and a forgery
point to such an index is left to R5.
\end{lemma}

\begin{proof}
The first basis row obeys $g-hf\equiv0$.  Since $f$ is invertible modulo
$(q,\Phi)$,
\[
 f(G-hF)=(fG-gF)+F(g-hf)\equiv q\equiv0
 \pmod{(q,\Phi)},
\]
so the second row also lies in the kernel.  The displayed inverse follows
from $\det\mathbf B=fG-gF=q$, and therefore
$A_h(z)=A_h(c,0)-A_h(y\mathbf B)=c$.

For the verifier direction,
$y_1\equiv hz_2-c$, hence $-y_1+hz_2\equiv c$.  Since $q$ is odd, centered
reduction is antisymmetric, so
$-y_1=\operatorname{center}_q(c-hz_2)$.  The form $Q_R$ is quadratic,
so $Q_R(-y_1)=Q_R(y_1)$; the verifier's strict test is exactly the required
metric inequality.
\end{proof}

\begin{remark}[Relation to homogeneous kernel problems]
If $z\ne z'$ are two witnesses for the same $(h,c)$, then
$w=z-z'\ne0$ satisfies $w_1+hw_2\equiv0$ and, for the norm
$\|v\|_Q=\sqrt{Q(v)}$,
\[
 \|w\|_Q<2\sqrt B,\qquad Q(w)<4B.
\]
Moreover, the centered-box premises yield only
$w_2\in[-18432,18432]^{1536}$.
A single inhomogeneous witness also gives the exact homogenization
\[
 (z_1,z_2,-1)\in
 \ker\bigl[(a,b,t)\mapsto a+hb+ct\bigr].
\]
Neither observation is an equivalence with the two-column homogeneous NTRU
kernel problem, nor a reduction from a standard SIS/NTRU assumption.  The
random-target preimage hardness in Assumption~\ref{ass:R4-mtisis} remains an
explicit assumption.
\end{remark}

\begin{remark}[The norm and centered-component conditions are independent]
The block eigenvalues are $1/2$ and $3/2$, hence
$Q(z)\ge\frac12\|z\|_2^2$.  The norm condition alone yields only the coarse
coordinate upper bound
\[
 \sqrt{2B}=64713.559398\ldots>9216=(q-1)/2.
\]
More decisively, take $z_1=0$ and let exactly one coefficient of $z_2$ be
$9217$, with its paired coefficient and all other coefficients zero.  Then
\[
 Q(z_1,z_2)=9217^2=84953089<B,
 \qquad z_2\notin\mathcal C_q.
\]
Conversely, take $z_1=0$ and set $25$ coefficients of $z_2$ from distinct
$A_2$ blocks to $9216$, with their partners and all other coefficients zero.
Then $z_2\in\mathcal C_q$ but
\[
 Q(z_1,z_2)=25\cdot9216^2=2123366400>B.
\]
Thus neither condition implies the other.  The centered condition records
the canonical decoded COMP\_NONE component explicitly and strengthens the
broader congruence-and-norm relation stated informally in the supplement.
\end{remark}
