"\tfor (u = 0; u < hn; u ++) {\n",
"\t\tfpr F_re, F_im, G_re, G_im;\n",
"\t\tfpr f_re, f_im, g_re, g_im;\n",
"\t\tfpr a_re, a_im, b_re, b_im;\n",
"\n",
"\t\tF_re = F[u];\n",
"\t\tF_im = F[u + hn];\n",
"\t\tG_re = G[u];\n",
"\t\tG_im = G[u + hn];\n",
"\t\tf_re = f[u];\n",
