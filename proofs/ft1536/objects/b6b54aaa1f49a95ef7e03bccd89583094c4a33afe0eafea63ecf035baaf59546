"/* see internal.h */\n",
"void\n",
"falcon_poly_add_muladj_fft3(fpr *restrict d,\n",
"\tconst fpr *restrict F, const fpr *restrict G,\n",
"\tconst fpr *restrict f, const fpr *restrict g,\n",
"\tunsigned logn, unsigned full)\n",
"{\n",
"\tsize_t n, hn, u;\n",
"\n",
"\tn = MKN(logn, full);\n",
