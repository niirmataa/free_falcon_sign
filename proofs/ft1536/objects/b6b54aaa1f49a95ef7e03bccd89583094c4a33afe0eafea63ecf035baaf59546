"\t\tFPC_MUL(a_re, a_im, F_re, F_im, f_re, fpr_neg(f_im));\n",
"\t\tFPC_MUL(b_re, b_im, G_re, G_im, g_re, fpr_neg(g_im));\n",
"\t\td[u] = fpr_add(a_re, b_re);\n",
"\t\td[u + hn] = fpr_add(a_im, b_im);\n",
"\t}\n",
"}\n",
