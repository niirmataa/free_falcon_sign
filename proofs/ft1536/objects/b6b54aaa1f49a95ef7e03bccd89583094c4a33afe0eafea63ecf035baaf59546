"\t\tfpr fpct_a_re, fpct_a_im; \\\n",
"\t\tfpr fpct_b_re, fpct_b_im; \\\n",
"\t\tfpr fpct_d_re, fpct_d_im; \\\n",
"\t\tfpr fpct_m; \\\n",
"\t\tfpct_a_re = (a_re); \\\n",
"\t\tfpct_a_im = (a_im); \\\n",
"\t\tfpct_b_re = (b_re); \\\n",
