def horner (xs : List ℕ) (a : ℕ) : ℕ := xs.foldr (fun k v => k+a*v) 0

theorem horner_sum (xs : List ℕ) (a : ℕ) :
    horner xs a=∑ k ∈ range xs.length,(xs[k]?).getD 0*a^k := by
  induction xs with
  | nil => simp [horner]
  | cons b xs ih =>
    change b+a*horner xs a=_
    rw [List.length_cons,sum_range_succ']
    simp only [List.getElem?_cons_zero,Option.getD_some,pow_zero,mul_one,
      List.getElem?_cons_succ,pow_succ]
    rw [ih,mul_sum,add_comm b]
    congr 1
    apply sum_congr rfl
    intro k _
    ring

def numerator (a : ℕ) : ℕ := horner coefficients.toList a

theorem coefficient_count : coefficients.size=48 := by decide

theorem coefficient_identity : ∀ k : Fin 48,
    (coefficients[k.val]?).getD 0*c^k.val*k.val.factorial=denominator := by decide

theorem denominator_positive : 0<denominator := by decide

theorem numerator_sum (a : ℕ) : numerator a=
    ∑ k ∈ range 48,(coefficients[k]?).getD 0*a^k := by
  rw [numerator,horner_sum,Array.length_toList,coefficient_count]
  simp only [Array.getElem?_toList]

theorem numerator_real (a : ℕ) : (numerator a : ℝ)/(denominator : ℝ)=taylor ((a : ℝ)/c) := by
  rw [numerator_sum,Nat.cast_sum,Finset.sum_div]
  unfold taylor
  apply sum_congr rfl
  intro k hk
  have hD : (denominator : ℝ)≠0 := by exact_mod_cast (ne_of_gt denominator_positive)
  have hc : (c : ℝ)≠0 := by norm_num [c]
  have hf : (k.factorial : ℝ)≠0 := by exact_mod_cast (Nat.factorial_ne_zero k)
  have hi := coefficient_identity ⟨k,mem_range.mp hk⟩
  have hir : ((coefficients[k]?).getD 0 : ℝ)*(c : ℝ)^k*(k.factorial : ℝ)=(denominator : ℝ) := by
    exact_mod_cast hi
  push_cast
  rw [div_pow]
  field_simp
  nlinarith [congrArg (fun v : ℝ => v*(a : ℝ)^k) hir]

theorem numerator_positive (a : ℕ) : 0<numerator a := by
  rw [numerator_sum]
  have hh := single_le_sum (s:=range 48)
    (f:=fun k => (coefficients[k]?).getD 0*a^k)
    (fun _ _ => Nat.zero_le _) (show 0∈range 48 by decide)
  norm_num only [pow_zero,mul_one] at hh
  exact (show 0<(coefficients[0]?).getD 0 by decide).trans_le hh

theorem step_polynomial_bounds (k : ℕ) (hk : k<30720) :
    (numerator (2*k+1) : ℝ)/denominator≤Real.exp (step k) ∧
      Real.exp (step k)≤(numerator (2*k+1) : ℝ)/denominator+1/2^400 := by
  rw [numerator_real]
  have he : ((2*k+1 : ℕ) : ℝ)/(c : ℝ)=step k := by unfold step c; push_cast; ring
  rw [he]
  exact step_exp_bounds k hk

