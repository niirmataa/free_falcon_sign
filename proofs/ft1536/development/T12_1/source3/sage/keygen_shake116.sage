#!/usr/bin/env sage
# Extract a small public synthetic process_block fixture from sealed evidence.
# This is a local source-call control, not a complete seed-to-KeyGen witness.
import hashlib, json
from pathlib import Path
from sage.env import SAGE_VERSION

root=next(p for p in [Path.cwd(),*Path.cwd().parents] if (p/'notes/run/KEYGEN_SUCCESS_BIG_TODO.md').is_file())
dest=Path.cwd()
def sha(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
manifest=root/'.build/jobs/keygen_witness113_005/WITNESS113.json'
assert sha(manifest)=='dda0d8b5ec86f6b29139bf6c6ef02f30146ecf7cba87e9fe042b7b8624839ddf'
evidence=json.loads(manifest.read_text())
source=Path(evidence['selected'])/'events.bin'
expected=next(row['sha256'] for row in evidence['artifacts'] if row['path']==str(source))
assert sha(source)==expected
raw=source.read_bytes();position=0;events=[]
while position<len(raw):
    size=int.from_bytes(raw[position:position+4],'little');position+=4
    tag=raw[position:position+size].decode();position+=size
    size=int.from_bytes(raw[position:position+8],'little');position+=8
    data=raw[position:position+size];assert len(data)==size;position+=size
    events.append((tag,data))
assert position==len(raw)
before=next(data for tag,data in events if tag=='shake_before')
after=next(data for tag,data in events if tag=='shake_after')
assert len(before)==len(after)==416
assert ZZ(int.from_bytes(before[200:208],'little'))==136
assert ZZ(int.from_bytes(after[200:208],'little'))==8
assert before[208:216]==after[208:216]==int(136).to_bytes(8,'little')
def words(data):
    values=[ZZ(int.from_bytes(data[216+8*i:224+8*i],'little')) for i in range(25)]
    assert b''.join(int(v).to_bytes(8,'little') for v in values)==data[216:416]
    assert all(0<=v<2^64 for v in values)
    return values
old,new=words(before),words(after)
def lean_list(xs):return '['+',\n  '.join(hex(int(v)) for v in xs)+']'
module='''import Source3.ShakeProcessCompute116

set_option maxRecDepth 32768
set_option maxHeartbeats 2000000
set_option Elab.async false

/- Generated by sage/keygen_shake116.sage from the pinned PUBLIC SYNTHETIC
   counter9 fixture. These are local A-array inputs/outputs, not a private
   deployment key and not an assumed source trace or seed initialization. -/
namespace FT1536.Source3.ShakeBlockFixture116
open C99MemoryReference (ArrayPointer)
open C99FiniteMemory114 (Block Heap putBlock)
open C99CompactState115 (State reference)

def beforeWords : List (BitVec 64) := OLD_WORDS
def afterWords : List (BitVec 64) := NEW_WORDS

def wordsBlock (size : Nat) (writable : Bool) (offset : Nat) (words : List (BitVec 64)) : Block :=
  words.zipIdx.foldl (fun block pair =>
    (List.range 8).foldl (fun block j => block.put (offset+8*pair.2+j)
      (BitVec.ofNat 8 (pair.1.toNat / 2^(8*j)))) block) ⟨size,writable,some 0,.empty⟩

def heap (words : List (BitVec 64)) : Heap :=
  putBlock (putBlock ⟨.empty⟩ 1 (wordsBlock 448 true 224 words)) 20
    (wordsBlock 192 false 0 ShakeExtractSource.rc)

def pointer : ArrayPointer := ⟨1,224,25,8,0⟩
def table : ArrayPointer := ⟨20,0,24,8,0⟩
def before : State := ⟨heap beforeWords,[],[],[],[("RC".toList,table)]⟩
def after : State := {before with heap := heap afterWords}

theorem static_checked : ShakeProcessCompute116.StaticGuard before.heap table := by decide +kernel

/-- Intermediate states of the local fixture share all caller fields. -/
def state (words : List (BitVec 64)) (locals : C99CompactCells115.Locals) : State :=
  {ShakeProcessCompute116.entry before pointer table with heap := heap words, locals := locals}

end FT1536.Source3.ShakeBlockFixture116
'''.replace('OLD_WORDS',lean_list(old)).replace('NEW_WORDS',lean_list(new))
target=dest/'ShakeBlockFixture116.lean';target.write_text(module)
result={'status':'PUBLIC_LOCAL_FIXTURE_EXTRACTED; KERNEL_CHECK_SEPARATE','sage_version':SAGE_VERSION,
    'inputs':[{'path':str(manifest),'sha256':sha(manifest)},{'path':str(source),'sha256':sha(source)}],
    'output':{'path':str(target),'sha256':sha(target)},'word_count':int(25),'exact_domain':'ZZ',
    'whole_source_witness':False,'seed_initialization_bound':False}
(dest/'FIXTURE116.json').write_text(json.dumps(result,indent=2)+'\n')
